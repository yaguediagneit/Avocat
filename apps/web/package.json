{
  "name": "avocat-web",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "node server.js",
    "build": "next build",
    "start": "NODE_ENV=production node server.js",
    "lint": "next lint",
    "test": "vitest",
    "db:init": "tsx init.ts",
    "db:generate:public": "prisma generate --schema=./prisma/schema/public.prisma",
    "db:generate:tenant": "prisma generate --schema=./prisma/schema/tenant.prisma",
    "db:migrate:public": "prisma migrate dev --schema=./prisma/schema/public.prisma",
    "db:migrate:tenant": "prisma migrate dev --schema=./prisma/schema/tenant.prisma",
    "db:seed": "tsx seed.ts"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.609.0",
    "@aws-sdk/s3-request-presigner": "^3.609.0",
    "@prisma/client": "^5.16.0",
    "argon2": "^0.40.3",
    "canvas": "^3.2.3",
    "clsx": "^2.1.1",
    "docxtemplater": "^3.69.3",
    "iron-session": "^8.0.2",
    "jose": "^6.2.10",
    "meilisearch": "^0.41.0",
    "next": "14.2.5",
    "nodemailer": "^10.0.9",
    "pdf-lib": "^1.17.1",
    "pdf-parse": "^2.4.5",
    "pdfjs-dist": "^5.4.624",
    "pizzip": "^3.2.0",
    "prisma": "^5.16.0",
    "qrcode": "^1.5.3",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "redis": "^4.6.14",
    "speakeasy": "^2.0.0",
    "tailwind-merge": "^2.3.0",
    "tesseract.js": "^5.1.0",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/node": "^20.14.9",
    "@types/nodemailer": "^8.0.1",
    "@types/qrcode": "^1.5.5",
    "@types/react": "^18.3.3",
    "@types/react-dom": "^18.3.0",
    "@types/speakeasy": "^2.0.10",
    "@vitejs/plugin-react": "^4.3.1",
    "autoprefixer": "^10.4.19",
    "eslint": "^8.57.0",
    "eslint-config-next": "14.2.5",
    "playwright": "^1.45.0",
    "postcss": "^8.4.38",
    "tailwindcss": "^3.4.4",
    "tsx": "^4.16.2",
    "typescript": "^5.5.3",
    "vitest": "^1.6.0"
  }
}
