}

model Employee {
  id            String   @id @default(uuid())
  employeeCode  String   @unique @map("employee_code")
  firstName     String   @map("first_name")
  lastName      String   @map("last_name")
  position      String?
  department    String?
  hireDate       DateTime  @map("hire_date")
  contractType   String    @map("contract_type")
  contractEndDate DateTime? @map("contract_end_date")
  baseSalary     Int     @map("base_salary")
  cnssNumber          String? @map("cnss_number")
  ipresNumber         String? @map("ipres_number")
  irppNumber          String? @map("irpp_number")
  insurancePolicyNumber String? @map("insurance_policy_number")
  bankAccount         String? @map("bank_account")
  email         String?
  phone         String?
  maritalStatus String   @map("marital_status")
  nbChildren    Int      @default(0) @map("nb_children")
  taxShares     Float    @default(1) @map("tax_shares")
  regime        String   @default("general") @map("regime")
