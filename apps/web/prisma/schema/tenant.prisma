  id                  String   @id @default(uuid())
  employeeId          String   @unique @map("employee_id")
  employee            Employee @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  policyId            String   @map("policy_id")
  policy              LeavePolicy @relation(fields: [policyId], references: [id])
  joursParMois        Float?   @map("jours_par_mois")
  dateDebutAcquisition DateTime? @map("date_debut_acquisition")
  autoriserAnticipation Boolean? @map("autoriser_anticipation")
  createdAt           DateTime @default(now()) @map("created_at")
  updatedAt           DateTime @updatedAt @map("updated_at")

  @@map("employee_leave_settings")
}

/// Jours fériés.
model Holiday {
  id        String   @id @default(uuid())
  dateJour  DateTime @unique @map("date_jour") @db.Date
  libelle   String
  national  Boolean  @default(true)
  actif     Boolean  @default(true)
  createdAt DateTime @default(now()) @map("created_at")

  @@map("holidays")
}

/// Demande de congé ou absence.
model LeaveRequest {
  id                 String   @id @default(uuid())
  employeeId         String   @map("employee_id")
  employee           Employee @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  leaveTypeId        String   @map("leave_type_id")
  leaveType          LeaveType @relation(fields: [leaveTypeId], references: [id])
  /// Employé responsable approbateur (manager direct / RH).
  approverId         String?  @map("approver_id")
  dateDebut          DateTime @map("date_debut") @db.Date
  dateFin            DateTime @map("date_fin") @db.Date
  nombreJours        Float    @default(0) @map("nombre_jours")
  motif              String?
  justificatif       String?
  /// "brouillon" | "soumise" | "en_correction" | "approuvee" | "rejetee" | "annulee" | "terminee"
  statut             String   @default("brouillon") @map("statut")
  commentaireValidation String? @map("commentaire_validation")
  submittedAt        DateTime? @map("submitted_at")
  decidedAt          DateTime? @map("decided_at")
  cancelledAt        DateTime? @map("cancelled_at")
  createdBy          String   @map("created_by")
  updatedBy          String?  @map("updated_by")
  createdAt          DateTime @default(now()) @map("created_at")
  updatedAt          DateTime @updatedAt @map("updated_at")

  transactions      LeaveTransaction[]
  approvals         LeaveApproval[]
  comments          LeaveComment[]
  @@index([employeeId])
  @@index([statut])
  @@index([dateDebut])
  @@map("leave_requests")
}

/// Journal immuable des mouvements de solde.
model LeaveTransaction {
  id                String   @id @default(uuid())
  employeeId        String   @map("employee_id")
  employee          Employee @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  leaveRequestId    String?  @map("leave_request_id")
  leaveRequest      LeaveRequest? @relation(fields: [leaveRequestId], references: [id], onDelete: SetNull)
  periodeDebut      DateTime @map("periode_debut") @db.Date
  periodeFin        DateTime @map("periode_fin") @db.Date
  /// "acquisition" | "report" | "consommation" | "annulation" | "ajustement" | "expiration"
  typeTransaction   String   @map("type_transaction")
  nombreJours       Float    @map("nombre_jours")
  libelle           String
  createdBy         String?  @map("created_by")
  createdAt         DateTime @default(now()) @map("created_at")

  @@index([employeeId])
  @@index([typeTransaction])
  @@map("leave_transactions")
}

/// Commentaires d'une demande d'absence.
model LeaveComment {
  id             String   @id @default(uuid())
  leaveRequestId String   @map("leave_request_id")
  leaveRequest   LeaveRequest @relation(fields: [leaveRequestId], references: [id], onDelete: Cascade)
  authorId       String   @map("author_id")
  content        String
  createdAt      DateTime @default(now()) @map("created_at")

  @@index([leaveRequestId])
  @@map("leave_comments")
}

/// Historique des actions de validation.
model LeaveApproval {
  id               String   @id @default(uuid())
  leaveRequestId   String   @map("leave_request_id")
  leaveRequest     LeaveRequest @relation(fields: [leaveRequestId], references: [id], onDelete: Cascade)
  actorId          String   @map("actor_id")
  ancienStatut     String   @map("ancien_statut")
  nouveauStatut    String   @map("nouveau_statut")
  commentaire      String?
  createdAt        DateTime @default(now()) @map("created_at")

  @@index([leaveRequestId])
  @@index([actorId])
  @@map("leave_approvals")
}

/// Assureur du personnel (assurance maladie / soins).
model Insurer {
  id                String   @id @default(uuid())
  nom               String
  adresse           String?
  telephone         String?
  telephoneSecondaire String? @map("telephone_secondaire")
  email             String?
  siteWeb           String?  @map("site_web")
  referenceInterne  String?  @map("reference_interne")
  /// "actif" | "inactif"
  statut            String   @default("actif")
  observations      String?
  /// Gestionnaire de compte principal chez l'assureur.
  managerNom        String?  @map("manager_nom")
  managerFonction   String?  @map("manager_fonction")
  managerTelephone  String?  @map("manager_telephone")
  managerEmail      String?  @map("manager_email")
  createdAt         DateTime @default(now()) @map("created_at")
  updatedAt         DateTime @updatedAt @map("updated_at")

  contracts         InsuranceContract[]
  @@map("insurers")
}

/// Contrat d'assurance du cabinet avec un assureur, généralement sur 12 mois.
model InsuranceContract {
  id                    String   @id @default(uuid())
  insurerId             String   @map("insurer_id")
  insurer               Insurer  @relation(fields: [insurerId], references: [id])
  reference             String   @unique
  dateDebut             DateTime @map("date_debut")
  dateFin               DateTime @map("date_fin")
  /// "individuel" | "familial" | "entreprise"
  typeCouverture        String   @map("type_couverture")
  devise                String   @default("XOF")
  /// Pourcentage général de prise en charge (ex: 80.00 pour 80%).
  tauxGeneral           Float    @map("taux_general")
  /// Avance versée à l'assureur en début de période.
  montantAvance         Int      @default(0) @map("montant_avance")
  datePaiementAvance    DateTime? @map("date_paiement_avance")
  modePaiementAvance    String?  @map("mode_paiement_avance")
  referencePaiementAvance String? @map("reference_paiement_avance")
  /// "brouillon" | "actif" | "expire" | "resilie" | "cloture"
  statut                String   @default("brouillon") @map("statut")
  conditions            String?
  documentPath          String?  @map("document_path")
  factureAssureurPath   String?  @map("facture_assureur_path")
  chequePath            String?  @map("cheque_path")
  createdAt             DateTime @default(now()) @map("created_at")
  updatedAt             DateTime @updatedAt @map("updated_at")

  insuredEmployees    InsuredEmployee[]
  quotes              InsuranceQuote[]
  coverageRequests    CoverageRequest[]
  invoices            MedicalInvoice[]
  payments            InsurerPayment[]
  closures            InsurancePeriodClosure[]
  @@index([insurerId])
  @@index([statut])
  @@index([dateDebut, dateFin])
  @@map("insurance_contracts")
}

/// Rattachement d'un employé à un contrat d'assurance.
model InsuredEmployee {
  id                  String   @id @default(uuid())
  employeeId          String   @map("employee_id")
  employee            Employee @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  contractId          String   @map("contract_id")
  contract            InsuranceContract @relation(fields: [contractId], references: [id], onDelete: Cascade)
  numeroAdherent      String?  @map("numero_adherent")
  dateAdhesion        DateTime @map("date_adhesion")
  dateFinCouverture   DateTime? @map("date_fin_couverture")
  formule             String?
  tauxParticulier     Float?   @map("taux_particulier")
  plafondIndividuel   Int?     @map("plafond_individuel")
  /// "actif" | "suspendu" | "sorti"
  statut              String   @default("actif") @map("statut")
  createdAt           DateTime @default(now()) @map("created_at")
  updatedAt           DateTime @updatedAt @map("updated_at")

  dependents          EmployeeDependent[]
  quotes              InsuranceQuote[]
  coverageRequests    CoverageRequest[]
  invoices            MedicalInvoice[]
  @@unique([employeeId, contractId])
  @@index([employeeId])
  @@index([contractId])
  @@index([statut])
  @@map("insured_employees")
}

/// Ayant droit d'un employé assuré (membres de la famille).
model EmployeeDependent {
  id                  String   @id @default(uuid())
  employeeId          String   @map("employee_id")
  employee            Employee @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  insuredEmployeeId   String?  @map("insured_employee_id")
  insuredEmployee     InsuredEmployee? @relation(fields: [insuredEmployeeId], references: [id], onDelete: SetNull)
  nom                 String
  prenom              String
  /// "M" | "F" | "autre"
  sexe                String?
  dateNaissance       DateTime? @map("date_naissance")
  /// "conjoint" | "enfant" | "pere" | "mere" | "autre"
  lienFamilial        String   @map("lien_familial")
  numeroAdherent      String?  @map("numero_adherent")
  dateDebutCouverture DateTime? @map("date_debut_couverture")
  dateFinCouverture   DateTime? @map("date_fin_couverture")
  tauxParticulier     Float?   @map("taux_particulier")
  plafondParticulier  Int?     @map("plafond_particulier")
  /// "actif" | "inactif"
  statut              String   @default("actif") @map("statut")
  justificatifPath    String?  @map("justificatif_path")
  observations        String?
  createdAt           DateTime @default(now()) @map("created_at")
  updatedAt           DateTime @updatedAt @map("updated_at")

  quotes              InsuranceQuote[]
  coverageRequests    CoverageRequest[]
  invoices            MedicalInvoice[]
  @@index([employeeId])
  @@index([insuredEmployeeId])
  @@index([statut])
  @@map("employee_dependents")
}

/// Prestataire médical (clinique, pharmacie, laboratoire...).
model MedicalProvider {
  id            String   @id @default(uuid())
  nom           String
  adresse       String?
  telephone     String?
  email         String?
  typePrestataire String? @map("type_prestataire")
  /// "actif" | "inactif"
  statut        String   @default("actif") @map("statut")
  createdAt     DateTime @default(now()) @map("created_at")
  updatedAt     DateTime @updatedAt @map("updated_at")

  quotes              InsuranceQuote[]
  coverageRequests    CoverageRequest[]
  invoices            MedicalInvoice[]
  @@map("medical_providers")
}

/// Devis médical estimatif avant soins.
model InsuranceQuote {
  id                    String   @id @default(uuid())
  reference             String   @unique
  insuredEmployeeId     String   @map("insured_employee_id")
  insuredEmployee       InsuredEmployee @relation(fields: [insuredEmployeeId], references: [id], onDelete: Cascade)
  dependentId           String?  @map("dependent_id")
  dependent             EmployeeDependent? @relation(fields: [dependentId], references: [id], onDelete: SetNull)
  contractId            String   @map("contract_id")
  contract              InsuranceContract @relation(fields: [contractId], references: [id], onDelete: Cascade)
  providerId            String   @map("provider_id")
  provider              MedicalProvider @relation(fields: [providerId], references: [id], onDelete: Cascade)
  dateDevis             DateTime @map("date_devis")
  dateValidite          DateTime? @map("date_validite")
  typeSoin              String   @map("type_soin")
  montantTotal          Int      @map("montant_total")
  tauxApplique          Float    @map("taux_applique")
  partCabinetEstimee    Int      @default(0) @map("part_cabinet_estimee")
  partEmployeEstimee    Int      @default(0) @map("part_employe_estimee")
  /// "brouillon" | "valide" | "expire" | "annule"
  statut                String   @default("brouillon") @map("statut")
  documentPath          String?  @map("document_path")
  observations          String?
  createdAt             DateTime @default(now()) @map("created_at")
  updatedAt             DateTime @updatedAt @map("updated_at")

  coverageRequests    CoverageRequest[]
  @@index([insuredEmployeeId])
  @@index([contractId])
  @@index([providerId])
  @@map("insurance_quotes")
}

/// Dossier de prise en charge soumis à l'assureur sur la base d'un devis.
model CoverageRequest {
  id                          String   @id @default(uuid())
  reference                   String   @unique
  insuredEmployeeId           String   @map("insured_employee_id")
  insuredEmployee             InsuredEmployee @relation(fields: [insuredEmployeeId], references: [id], onDelete: Cascade)
  dependentId                 String?  @map("dependent_id")
  dependent                   EmployeeDependent? @relation(fields: [dependentId], references: [id], onDelete: SetNull)
  contractId                  String   @map("contract_id")
  contract                    InsuranceContract @relation(fields: [contractId], references: [id], onDelete: Cascade)
  quoteId                     String?  @map("quote_id")
  quote                       InsuranceQuote? @relation(fields: [quoteId], references: [id], onDelete: SetNull)
  providerId                  String   @map("provider_id")
  provider                    MedicalProvider @relation(fields: [providerId], references: [id], onDelete: Cascade)
  dateSoinsPrevue             DateTime @map("date_soins_prevue")
  montantEstime               Int      @map("montant_estime")
  tauxDemande                 Float    @map("taux_demande")
  montantPrisEnChargeEstime   Int      @default(0) @map("montant_pris_en_charge_estime")
  montantEmployeEstime        Int      @default(0) @map("montant_employe_estime")
  /// "brouillon" | "soumise" | "envoyee" | "complement" | "approuvee" | "approuvee_partielle" | "rejetee" | "expiree" | "annulee" | "consommee"
  statut                      String   @default("brouillon") @map("statut")
  dateEnvoi                   DateTime? @map("date_envoi")
  dateReponse                 DateTime? @map("date_reponse")
  dateExpiration              DateTime? @map("date_expiration")
  commentaireAssureur         String?  @map("commentaire_assureur")
  createdBy                   String   @map("created_by")
  createdAt                   DateTime @default(now()) @map("created_at")
  updatedAt                   DateTime @updatedAt @map("updated_at")

  invoices            MedicalInvoice[]
  @@index([insuredEmployeeId])
  @@index([contractId])
  @@index([quoteId])
  @@index([providerId])
  @@index([statut])
  @@map("coverage_requests")
}

/// Facture médicale rattachée à un contrat, un bénéficiaire et éventuellement une prise en charge.
model MedicalInvoice {
  id                    String   @id @default(uuid())
  referenceInterne      String   @unique @map("reference_interne")
  numeroFacture         String?  @map("numero_facture")
  insuredEmployeeId     String   @map("insured_employee_id")
  insuredEmployee       InsuredEmployee @relation(fields: [insuredEmployeeId], references: [id], onDelete: Cascade)
  dependentId           String?  @map("dependent_id")
  dependent             EmployeeDependent? @relation(fields: [dependentId], references: [id], onDelete: SetNull)
  contractId            String   @map("contract_id")
  contract              InsuranceContract @relation(fields: [contractId], references: [id], onDelete: Cascade)
  coverageRequestId     String?  @map("coverage_request_id")
  coverageRequest       CoverageRequest? @relation(fields: [coverageRequestId], references: [id], onDelete: SetNull)
  providerId            String   @map("provider_id")
  provider              MedicalProvider @relation(fields: [providerId], references: [id], onDelete: Cascade)
  dateSoins             DateTime @map("date_soins")
  dateFacture           DateTime @map("date_facture")
  typeSoin              String   @map("type_soin")
  montantTotal          Int      @map("montant_total")
  tauxApplique          Float    @map("taux_applique")
  partCabinet           Int      @default(0) @map("part_cabinet")
  partEmploye           Int      @default(0) @map("part_employe")
  montantPayeEmploye    Int      @default(0) @map("montant_paye_employe")
  resteAPayerEmploye    Int      @default(0) @map("reste_a_payer_employe")
  /// "brouillon" | "soumise" | "validee" | "payee_cabinet" | "rejetee" | "annulee"
  statut                String   @default("brouillon") @map("statut")
  /// "non_paye" | "partiel" | "paye" | "exonere" | "annule"
  statutPaiementEmploye String   @default("non_paye") @map("statut_paiement_employe")
  justificatifPath      String?  @map("justificatif_path")
  factureAssureurPath   String?  @map("facture_assureur_path")
  chequePath            String?  @map("cheque_path")
  commentaire           String?
  createdBy             String   @map("created_by")
  createdAt             DateTime @default(now()) @map("created_at")
  updatedAt             DateTime @updatedAt @map("updated_at")

  payments            EmployeeInsurancePayment[]
  @@index([insuredEmployeeId])
  @@index([dependentId])
  @@index([contractId])
  @@index([coverageRequestId])
  @@index([providerId])
  @@index([statut])
  @@map("medical_invoices")
}

/// Paiement effectué par l'employé sur sa part d'une facture médicale.
model EmployeeInsurancePayment {
  id                 String         @id @default(uuid())
  invoiceId          String         @map("invoice_id")
  invoice            MedicalInvoice @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
  montant            Int
  datePaiement       DateTime       @map("date_paiement")
  /// "especes" | "cheque" | "virement" | "mobile_money" | "autre"
  modePaiement       String         @map("mode_paiement")
  referencePaiement  String?        @map("reference_paiement")
  recuPath           String?        @map("recu_path")
  receivedBy         String         @map("received_by")
  observations       String?
  createdAt          DateTime       @default(now()) @map("created_at")

  @@index([invoiceId])
  @@map("employee_insurance_payments")
}

/// Paiements versés à l'assureur (avance, complément, remboursement, crédit).
/// Statut : "brouillon" | "approuve" | "paye" | "annule".
model InsurerPayment {
  id                String            @id @default(uuid())
  contractId        String            @map("contract_id")
  contract          InsuranceContract @relation(fields: [contractId], references: [id], onDelete: Cascade)
  /// "avance" | "complement" | "remboursement" | "credit"
  typePaiement      String            @map("type_paiement")
  montant           Int
  datePaiement      DateTime          @map("date_paiement")
  /// "especes" | "cheque" | "virement" | "mobile_money" | "autre"
  modePaiement      String            @map("mode_paiement")
  referencePaiement String?           @map("reference_paiement")
  justificatifPath  String?           @map("justificatif_path")
  /// "brouillon" | "approuve" | "paye" | "annule"
  statut            String            @default("brouillon") @map("statut")
  approvedBy        String?           @map("approved_by")
  approvedAt        DateTime?         @map("approved_at")
  paidBy            String?           @map("paid_by")
  paidAt            DateTime?         @map("paid_at")
  accountingEntryId String?           @map("accounting_entry_id")
  accountingEntry   AccountingEntry?  @relation(fields: [accountingEntryId], references: [id], onDelete: SetNull)
  createdBy         String            @map("created_by")
  createdAt         DateTime          @default(now()) @map("created_at")

  @@index([contractId])
  @@index([typePaiement])
  @@index([statut])
  @@index([accountingEntryId])
  @@map("insurer_payments")
}

/// Clôture de période d'un contrat d'assurance.
model InsurancePeriodClosure {
  id                  String            @id @default(uuid())
  contractId          String            @map("contract_id")
  contract            InsuranceContract @relation(fields: [contractId], references: [id], onDelete: Cascade)
  periodeDebut        DateTime          @map("periode_debut")
  periodeFin          DateTime          @map("periode_fin")
  totalFactures       Int               @default(0) @map("total_factures")
  totalPartEmployes   Int               @default(0) @map("total_part_employes")
  totalPayeEmployes   Int               @default(0) @map("total_paye_employes")
  totalPartCabinet    Int               @default(0) @map("total_part_cabinet")
  totalAvances        Int               @default(0) @map("total_avances")
  soldeAPayer         Int               @default(0) @map("solde_a_payer")
  creditAReporter     Int               @default(0) @map("credit_a_reporter")
  /// "ouverte" | "controle" | "cloturee" | "rouverte"
  statut              String            @default("ouverte") @map("statut")
  validePar           String?           @map("valide_par")
  dateValidation      DateTime?         @map("date_validation")
  observations        String?
  createdAt           DateTime          @default(now()) @map("created_at")
  updatedAt           DateTime          @updatedAt @map("updated_at")

  @@index([contractId])
  @@index([statut])
  @@map("insurance_period_closures")
}

// ------------------------------------------------------------------
// Module « Démarches administratives » (foncier, urbanisme, fiscalité)
// ------------------------------------------------------------------

/// Catalogue paramétrable des types de démarches (URB_CONSTRUIRE, CAD_NICAD…).
/// L'administrateur du cabinet peut modifier autorités, pièces, modèles,
/// taxes, délais et règles de validation — rien n'est codé en dur dans les pages.
model DemarcheType {
  id                   String  @id @default(uuid())
  code                 String  @unique
  libelle              String
  /// "URBANISME" | "CADASTRE" | "FISCALITE" | "DOMAINES" | "LIVRE_FONCIER" | "TRANSVERSAL"
  famille              String
  /// Description de l'autorité / interlocuteur principal (texte, paramétrable).
  autoritePrincipale   String?
  /// Nature du résultat attendu (autorisation, certificat, titre foncier…).
  natureResultat       String?
  /// Sous-types / précisions exigés pour la qualification : [{ code, libelle }].
  sousTypes            Json?
  /// Démarche ambiguë : sous-type, document visé et autorité obligatoires
  /// avant toute préparation / dépôt (état A_QUALIFIER).
  qualificationObligatoire Boolean @default(false)
  /// Une fiche parcelle / bien est requise pour ce type de démarche.
  parcelleRequise      Boolean @default(false)
  /// Validation renforcée par avocat / fiscaliste avant dépôt.
  validationAvocat     Boolean @default(false)
  /// Dossier sensible (succession, fiscalité, sûretés) : accès restreint.
  sensible             Boolean @default(false)
  /// Nombre d'exemplaires du paquet de dépôt (ex. 2 dossier simple, 3 complexe).
  nbExemplaires        Int     @default(2)
  /// Délai (jours) sans mouvement avant relance interne automatique.
  delaiRelanceJours    Int     @default(15)
  /// Délai légal paramétrable (enregistrement, recours…) en jours.
  delaiLegalJours      Int?
  /// Règles de risque / pré-contrôles affichés (tableau de chaînes).
  reglesRisque         Json?
  /// Avertissement affiché sur la démarche (« sous réserve de recevabilité… »).
  avertissement        String?
  ordre                Int     @default(0)
  actif                Boolean @default(true)
  createdAt            DateTime @default(now())
  updatedAt            DateTime @updatedAt

  pieces    DemarcheTypePiece[]
  modeles   DemarcheModele[]
  demarches Demarche[]

  @@map("demarche_types")
}

/// Pièce attendue dans la check-list d'un type de démarche (paramétrable).
model DemarcheTypePiece {
  id       String       @id @default(uuid())
  typeId   String
  type     DemarcheType @relation(fields: [typeId], references: [id], onDelete: Cascade)
  code     String
  libelle  String
  /// DOCUMENT_INTERNE_CABINET | DOCUMENT_ADMINISTRATIF_A_OBTENIR |
  /// PIECE_CLIENT | PIECE_TECHNIQUE | PREUVE_DE_DEPOT_ET_SUIVI
  categorie String
  /// OBLIGATOIRE | CONDITIONNELLE | FACULTATIVE
  niveau   String  @default("OBLIGATOIRE")
  /// Condition d'exigibilité lisible (« si dépôt par le cabinet »…).
  condition String?
  /// CLIENT | CABINET | ADMINISTRATION | ARCHITECTE | GEOMETRE | NOTAIRE | AUTRE
  sourceAttendue String @default("CLIENT")
  ordre    Int     @default(0)
  actif    Boolean @default(true)

  @@unique([typeId, code])
  @@index([typeId])
  @@map("demarche_type_pieces")
}

/// Autorité / bureau compétent (mairie, bureau du cadastre, centre fiscal…).
/// Paramétrable par l'administrateur : adresses et contacts évolutifs.
model DemarcheAutorite {
  id           String  @id @default(uuid())
  nom          String
  /// MAIRIE | CADASTRE | DGID | CONSERVATION | CENTRE_FISCAL | TRIBUNAL | AUTRE
  typeAutorite String  @default("AUTRE")
  commune      String?
  departement  String?
  region       String?
  adresse      String?
  contact      String?
  actif        Boolean @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  demarches    Demarche[]

  @@map("demarche_autorites")
}

/// Fiche demandeur réutilisable (personne physique ou morale).
/// Distincte de `Client` : le demandeur peut être un héritier, un mandant,
/// un bénéficiaire réel ou un tiers non client du cabinet.
model Demandeur {
  id            String  @id @default(uuid())
  /// PHYSIQUE | MORALE
  typePersonne  String  @default("PHYSIQUE")
  // Personne physique
  civilite      String?
  nom           String
  prenoms       String?
  dateNaissance DateTime?
  lieuNaissance String?
  nationalite   String?
  profession    String?
  situationMatrimoniale String?
  pieceIdentiteType     String?  // CNI | PASSEPORT | AUTRE
  pieceIdentiteNumero   String?
  pieceIdentiteExpiration DateTime?
  // Personne morale
  raisonSociale String?
  formeJuridique String?
  ninea         String?
  rccm          String?
  siegeSocial   String?
  representantLegal String?
  qualiteSignataire String?
  piecePouvoir  String?
  // Coordonnées communes
  adresse       String?
  commune       String?
  departement   String?
  region        String?
  telephone     String?
  whatsapp      String?
  email         String?
  adresseCorrespondance String?
  // Fiscalité
  centreFiscal  String?
  numeroContribuable String?
  exerciceFiscal String?
  // Mandat / procuration : { existe, date, etendue, signataire,
  //   pieceIdentiteMandant, expiration, originalDetenu }
  mandat        Json?
  // Confidentialité : { baseTraitement, consentementCommunication,
  //   preferencesNotification, niveauConfidentialite }
  confidentialite Json?
  /// Lien optionnel vers un client existant du cabinet.
  clientId      String?
  client        Client? @relation(fields: [clientId], references: [id])
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  demarchesDemandeur  Demarche[]      @relation("DemarcheDemandeur")
  demarchesMandataire Demarche[]      @relation("DemarcheMandataire")
  parties             DemarchePartie[]
  transactionParties  TransactionPartie[]
  biens               Bien[]

  @@index([clientId])
  @@map("demandeurs")
}

/// Fiche parcelle / bien immobilier réutilisable et vérifiable.
model Parcelle {
  id              String  @id @default(uuid())
  region          String?
  departement     String?
  commune         String?
  quartier        String?  // quartier / village / lotissement
  adresse         String?  // adresse ou indications de localisation
  nicad           String?
  titreFoncier    String?
  /// bail | droit_superficie | permis_occuper | autorisation_occuper |
  /// deliberation | acte_attribution | autre
  typeDroit       String?
  referenceDroit  String?  // numéro du bail, permis, acte d'attribution…
  lot             String?
  bloc            String?
  ilot            String?
  numeroParcelle  String?
  section         String?
  superficie      Float?
  uniteSuperficie String?  // m2 | ha
  /// { lat, lng }
  coordonnees     Json?
  /// [{ nom, qualite, quotePart }]
  titulaires      Json?
  origineDroit    String?
  dateActe        DateTime?
  referencesEnregistrement String?
  /// Hypothèques, prénotations, saisies, servitudes, contentieux connus.
  chargesInscriptions String?
  usageActuel     String?
  usageProjete    String?
  referencesPlans String?
  auteurPlans     String?
  /// DECLARE | PIECES_RECUES | A_VERIFIER | VERIFIE | INCOHERENT
  etatVerification String @default("DECLARE")
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  demarches       Demarche[]
  biens           Bien[]

  @@index([nicad])
  @@map("parcelles")
}

/// Démarche administrative (foncier, urbanisme, fiscalité) préparée et
/// suivie par le cabinet — l'acte final reste délivré par l'administration.
model Demarche {
  id             String       @id @default(uuid())
  /// Référence interne automatique : DEM-AAAA-NNNN.
  reference      String       @unique
  typeId         String
  type           DemarcheType @relation(fields: [typeId], references: [id])
  /// Sous-type de qualification (code dans type.sousTypes ou texte libre).
  sousType       String?
  /// BROUILLON → A_QUALIFIER → ATTENTE_CLIENT → PIECES_PARTIELLES →
  /// CONTROLE_INTERNE → A_CORRIGER → PRET_VALIDATION → PRET_A_DEPOT →
  /// DEPOSE → EN_INSTRUCTION → COMPLEMENT_DEMANDE → RELANCE →
  /// ACCEPTE → DOCUMENT_DELIVRE → REFUSE → CLASSE_SANS_SUITE →
  /// RECOURS_A_ETUDIER → CLOTURE → ARCHIVE
  statut         String       @default("BROUILLON")
  /// BASSE | NORMALE | HAUTE | URGENTE
  priorite       String       @default("NORMALE")
  /// STANDARD | ELEVE
  risque         String       @default("STANDARD")
  /// Rattachement au dossier juridique : GED, RBAC, confidentialité.
  dossierId      String
  dossier        Dossier      @relation(fields: [dossierId], references: [id])
  demandeurId    String?
  demandeur      Demandeur?   @relation("DemarcheDemandeur", fields: [demandeurId], references: [id])
  mandataireId   String?
  mandataire     Demandeur?   @relation("DemarcheMandataire", fields: [mandataireId], references: [id])
  parcelleId     String?
  parcelle       Parcelle?    @relation(fields: [parcelleId], references: [id])
  autoriteId     String?
  autorite       DemarcheAutorite? @relation(fields: [autoriteId], references: [id])
  /// Autorité saisie librement quand non référencée au catalogue.
  autoriteLibre  String?
  adresseDepot   String?
  contactAutorite String?
  objet          String?
  finalite       String?
  fondement      String?
  referenceActes String?
  /// Données de qualification préalable (document/inscription visée, motif…).
  qualification  Json?
  urgent         Boolean      @default(false)
  dateLimite     DateTime?
  responsableId  String?
  assistanteId   String?
  agentLiaisonId String?
  // Dépôt
  dateDepot      DateTime?
  deposePar      String?
  canalDepot     String?
  numeroRecepisse String?
  prochaineRelance DateTime?
  // Décision
  decisionDate   DateTime?
  /// ACCEPTE | REFUSE | COMPLEMENT | CLASSE_SANS_SUITE
  decisionType   String?
  decisionNotes  String?
  motifRejet     String?
  voieRecours    String?
  recoursEcheance DateTime?
  /// Document administratif délivré (GED du dossier).
  documentDelivreId String?
  remisAuClientLe   DateTime?
  // Finances (séparées : honoraires vs débours vs taxes vs avances)
  honoraires     Int @default(0)
  debours        Int @default(0)
  taxes          Int @default(0)
  timbres        Int @default(0)
  avancesRecues  Int @default(0)
  /// Dérogations aux pièces obligatoires : [{ pieceId, motif, validePar, date }]
  derogations    Json?
  noteRecevabilite String?
  valideParId    String?
  valideLe       DateTime?
  creePar        String
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
  archiveLe      DateTime?

  /// Transaction orchesttrant cette démarche (formalité externe
  /// d'une vente / bail : enregistrement, conservation, cadastre…).
  transactionId  String?
  transaction    Transaction? @relation(fields: [transactionId], references: [id])
  formalites     TransactionFormalite[]

  pieces     DemarchePiece[]
  evenements DemarcheEvenement[]
  frais      DemarcheFrais[]
  parties    DemarchePartie[]

  @@index([dossierId])
  @@index([statut])
  @@index([typeId])
  @@index([demandeurId])
  @@index([prochaineRelance])
  @@index([transactionId])
  @@map("demarches")
}

/// Co-demandeur, mandataire ou bénéficiaire réel rattaché à une démarche.
model DemarchePartie {
  id          String    @id @default(uuid())
  demarcheId  String
  demarche    Demarche  @relation(fields: [demarcheId], references: [id], onDelete: Cascade)
  demandeurId String
  demandeur   Demandeur @relation(fields: [demandeurId], references: [id], onDelete: Cascade)
  /// DEMANDEUR | CO_DEMANDEUR | MANDATAIRE | BENEFICIAIRE
  role        String
  ordre       Int       @default(0)
  createdAt   DateTime  @default(now())

  @@unique([demarcheId, demandeurId, role])
  @@index([demarcheId])
  @@map("demarche_parties")
}

/// Ligne de check-list matérialisée sur une démarche (copie du template
/// du type, modifiable : pièces complémentaires exigées par l'administration).
model DemarchePiece {
  id          String   @id @default(uuid())
  demarcheId  String
  demarche    Demarche @relation(fields: [demarcheId], references: [id], onDelete: Cascade)
  code        String
  libelle     String
  categorie   String
  /// OBLIGATOIRE | CONDITIONNELLE | FACULTATIVE
  niveau      String   @default("OBLIGATOIRE")
  condition   String?
  sourceAttendue String @default("CLIENT")
  /// NON_DEMANDEE | DEMANDEE | RECUE | ILLISIBLE | EXPIREE |
  /// VALIDEE | NON_APPLICABLE | REJETEE
  statut      String   @default("NON_DEMANDEE")
  /// Document GED du dossier attaché à la pièce.
  documentId  String?
  recueLe     DateTime?
  verifiePar  String?
  verifieLe   DateTime?
  expireLe    DateTime?
  commentaire String?
  visibleClient Boolean @default(false)
  ordre       Int      @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([demarcheId])
  @@map("demarche_pieces")
}

/// Journal opérationnel : dépôts, relances, compléments, décisions,
/// remises de documents, notes et changements de statut.
model DemarcheEvenement {
  id          String   @id @default(uuid())
  demarcheId  String
  demarche    Demarche @relation(fields: [demarcheId], references: [id], onDelete: Cascade)
  /// DEPOT | RELANCE | COMPLEMENT | DECISION | REMISE | NOTE |
  /// CHANGEMENT_STATUT | VALIDATION | DEMANDE_PIECE_CLIENT
  type        String
  date        DateTime @default(now())
  description String?
  details     Json?
  creePar     String?
  createdAt   DateTime @default(now())

  @@index([demarcheId])
  @@index([date])
  @@map("demarche_evenements")
}

/// Débours, taxes, timbres, avances — séparés des honoraires du cabinet.
model DemarcheFrais {
  id          String   @id @default(uuid())
  demarcheId  String
  demarche    Demarche @relation(fields: [demarcheId], references: [id], onDelete: Cascade)
  /// HONORAIRE | DEBOURS | TAXE | TIMBRE | AVANCE_CLIENT
  nature      String
  libelle     String
  montant     Int      @default(0)
  date        DateTime @default(now())
  /// Numéro de quittance / référence de paiement.
  quittance   String?
  /// Justificatif dans la GED du dossier.
  documentId  String?
  /// Rapprochement comptable effectué (bloque la clôture sinon).
  rapproche   Boolean  @default(false)
  creePar     String?
  createdAt   DateTime @default(now())

  @@index([demarcheId])
  @@map("demarche_frais")
}

/// Modèle de document à variables ({{cle|Libellé}} / [Libellé]) rattaché
/// à un type de démarche — ou transversal quand typeId est null.
model DemarcheModele {
  id      String        @id @default(uuid())
  code    String        @unique  // TPL_*
  titre   String
  typeId  String?
  type    DemarcheType? @relation(fields: [typeId], references: [id], onDelete: SetNull)
  contenu String        @db.Text
  ordre   Int           @default(0)
  actif   Boolean       @default(true)
  createdAt DateTime    @default(now())
  updatedAt DateTime    @updatedAt

  @@index([typeId])
  @@map("demarche_modeles")
}


// ==================================================================
// Module « Transactions & contrats » (ventes, baux, mandats)
// Le cabinet intervient comme conseil / intermédiaire : il contrôle
// les pièces, prépare les avant-contrats et contrats, coordonne le
// notaire, organise l'enregistrement, suit les paiements et archive.
// Une vente sous titre foncier n'est achevée qu'après inscription de
// l'acquéreur au livre foncier (Conservation foncière).
// ==================================================================

/// Bien objet d'une transaction ou d'un mandat (immeuble, terrain,
/// appartement, studio, local…). Peut être rattaché à une fiche parcelle
/// du module foncier pour la traçabilité cadastrale.
model Bien {
  id             String  @id @default(uuid())
  /// TERRAIN | IMMEUBLE | APPARTEMENT | STUDIO | VILLA |
  /// LOCAL_COMMERCIAL | BUREAU | MEUBLE | AUTRE
  nature         String  @default("IMMEUBLE")
  designation    String
  adresse        String?
  quartier       String?
  commune        String?
  departement    String?
  region         String?
  superficie     Float?
  uniteSuperficie String? // m2 | ha
  nbPieces       Int?
  nbChambres     Int?
  etage          String?
  equipements    String?
  /// Référence interne ou externe du bien (BIEN-…).
  referenceBien  String?
  /// titre_foncier | bail | droit_superficie | permis_occuper |
  /// autorisation_occuper | propriete_coutumiere | autre
  typeDroit      String?
  referenceDroit String?
  /// DECLARE | PIECES_RECUES | A_VERIFIER | VERIFIE | INCOHERENT
  etatVerification String @default("DECLARE")
  /// LIBRE | LOUE | OCCUPE | EN_TRANSACTION | VENDU
  occupation     String?
  occupants      String?  // locataires, sous-locataires, occupants connus
  charges        String?  // hypothèques, saisies, prénotations, servitudes
  loyerMensuel   Int?
  /// Lien vers la fiche parcelle foncière, le cas échéant.
  parcelleId     String?
  parcelle       Parcelle? @relation(fields: [parcelleId], references: [id])
  /// Propriétaire / titulaire déclaré (fiche demandeur).
  proprietaireId String?
  proprietaire   Demandeur? @relation(fields: [proprietaireId], references: [id])
  notes          String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  transactions   TransactionBien[]

  @@index([nature])
  @@index([commune])
  @@index([parcelleId])
  @@map("biens")
}

/// Type de transaction / contrat (vente TF, promesse, bail, mandat…) —
/// paramétrable : workflow appliqué, check-lists, validations exigées.
model TransactionType {
  id             String  @id @default(uuid())
  code           String  @unique // VENTE_IMMOBILIER_TF, BAIL_COMMERCIAL…
  libelle        String
  /// VENTE_IMMOBILIER | VENTE_AUTRE | BAIL | AVENANT_RESILIATION |
  /// MANDAT | ETAT_LIEUX | AUTRE
  famille        String
  /// VENTE_TF | BAIL | GENERIQUE — workflow de statuts appliqué.
  workflow       String  @default("GENERIQUE")
  /// Interlocuteurs principaux (notaire, DGID, Conservation…).
  circuitPrincipal String?
  /// Un bien doit être rattaché à la transaction.
  bienRequis     Boolean @default(true)
  /// Circuit notarial obligatoire (mutation sous titre foncier…).
  notaireObligatoire Boolean @default(false)
  /// La mutation n'est achevée qu'après inscription au livre foncier :
  /// la clôture exige la preuve d'inscription de l'acquéreur.
  mutationFonciere Boolean @default(false)
  /// La formalité d'enregistrement doit être évaluée / suivie.
  enregistrementAEvaluer Boolean @default(false)
  /// Qualification préalable obligatoire (droit sur le bien à qualifier).
  qualificationObligatoire Boolean @default(false)
  /// Validation par un avocat avant signature / dépôt.
  validationAvocat Boolean @default(false)
  /// Dossier sensible (succession, sûretés, fiscalité) : accès restreint.
  sensible       Boolean @default(false)
  /// Nombre d'exemplaires originaux du contrat / paquet.
  nbExemplaires  Int     @default(2)
  /// Délai (jours) sans mouvement avant relance interne.
  delaiRelanceJours Int  @default(15)
  avertissement  String?
  ordre          Int     @default(0)
  actif          Boolean @default(true)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  pieces       TransactionTypePiece[]
  modeles      TransactionModele[]
  transactions Transaction[]

  @@map("transaction_types")
}

/// Pièce attendue dans la check-list d'un type de transaction.
/// `partieConcernee` indique à qui la pièce est demandée (vendeur,
/// acheteur, bailleur, locataire, garant…).
model TransactionTypePiece {
  id       String          @id @default(uuid())
  typeId   String
  type     TransactionType @relation(fields: [typeId], references: [id], onDelete: Cascade)
  code     String
  libelle  String
  /// DOCUMENT_INTERNE_CABINET | DOCUMENT_ADMINISTRATIF_A_OBTENIR |
  /// PIECE_CLIENT | PIECE_TECHNIQUE | PREUVE_DE_DEPOT_ET_SUIVI |
  /// ACTE_NOTARIE | CONTRAT_SIGNE
  categorie String
  /// OBLIGATOIRE | CONDITIONNELLE | FACULTATIVE
  niveau   String  @default("OBLIGATOIRE")
  /// Condition d'exigibilité lisible.
  condition String?
  /// VENDEUR | ACHETEUR | BAILLEUR | LOCATAIRE | GARANT | MANDANT |
  /// CABINET | NOTAIRE | TOUTES
  partieConcernee String @default("TOUTES")
  /// CLIENT | CABINET | ADMINISTRATION | ARCHITECTE | GEOMETRE |
  /// NOTAIRE | AUTRE
  sourceAttendue String @default("CLIENT")
  ordre    Int     @default(0)
  actif    Boolean @default(true)

  @@unique([typeId, code])
  @@index([typeId])
  @@map("transaction_type_pieces")
}

/// Transaction / contrat piloté par le cabinet en qualité de conseil et
/// d'intermédiaire. Toujours rattachée à un dossier juridique (GED, RBAC).
model Transaction {
  id             String          @id @default(uuid())
  /// Référence interne automatique : TRX-AAAA-NNNN.
  reference      String          @unique
  typeId         String
  type           TransactionType @relation(fields: [typeId], references: [id])
  sousType       String?
  /// Statut du workflow (dépend du type : VENTE_TF | BAIL | GENERIQUE).
  statut         String          @default("BROUILLON")
  /// Blocage orthogonal : code BLOQUE_* + motif documenté.
  blocage        String?
  blocageMotif   String?
  /// BASSE | NORMALE | HAUTE | URGENTE
  priorite       String          @default("NORMALE")
  /// STANDARD | ELEVE
  risque         String          @default("STANDARD")
  /// Rattachement au dossier juridique (GED, RBAC, confidentialité).
  dossierId      String
  dossier        Dossier         @relation(fields: [dossierId], references: [id])
  // Conditions financières
  prix           Int?            // prix de vente
  devise         String          @default("XOF")
  loyer          Int?
  depotGarantie  Int?
  avanceLoyer    Int?
  /// Échéancier : [{ date, montant, objet }]
  echeancier     Json?
  conditionsSuspensives String?
  jourEcheanceLoyer Int?
  // Circuit notarial et foncier (vente sous titre foncier)
  notaireNom     String?
  notaireEtude   String?
  notaireContact String?
  mandatSigne    Boolean         @default(false)
  documentMandatId String?
  etatDroitsReelsObtenu Boolean  @default(false)
  depotConservationLe DateTime?
  /// Inscription de l'acquéreur au livre foncier : preuve de fin de mutation.
  mutationInscrite   Boolean     @default(false)
  mutationInscriteLe DateTime?
  documentMutationId String?
  // Bail / occupation
  dateEffet      DateTime?
  dateFin        DateTime?
  dureeMois      Int?
  renouvellement String?
  droitDeLouerVerifie Boolean    @default(false)
  etatLieuxEntreeFait  Boolean   @default(false)
  etatLieuxSortieFait  Boolean   @default(false)
  // Bail — conditions financières détaillées (inspiré GESTIMMO)
  chargesMensuelles Int?
  /// FIXE | POURCENTAGE | INCLUSES
  chargesMode     String?
  chargesIncluses Boolean     @default(false)
  /// VIREMENT | ESPECES | CHEQUE | PRELEVEMENT | MOBILE_MONEY
  modePaiementLoyer String?
  /// Clauses particulières du bail : [String].
  clausesParticulieres Json?
  // Mandat — type et commission de l'intermédiaire
  /// GESTION | LOCATION | SIMPLE | EXCLUSIF | AUTRE
  typeMandat      String?
  /// POURCENTAGE | FIXE
  commissionType  String?
  commissionValeur Float?
  /// Base de calcul de la commission (ex. "loyers encaissés TTC").
  commissionBase  String?
  // Vente — décomposition financière (prix total = net + honoraires + taxes + frais)
  honorairesAgence Int?
  tva              Int?
  taxesMunicipales Int?
  fraisNotaire     Int?
  netVendeur       Int?
  // Général
  objet          String?
  qualification  Json?
  signaturePrevue DateTime?
  /// Date de signature de l'avant-contrat ou de l'acte / bail.
  acteSigneLe    DateTime?
  /// Contrat ou acte signé dans la GED du dossier.
  documentActeId String?
  remisAuClientLe DateTime?
  responsableId  String?
  assistanteId   String?
  // Finances du cabinet (jamais le prix de vente ni les fonds clients)
  honoraires     Int @default(0)
  debours        Int @default(0)
  avancesRecues  Int @default(0)
  /// Dérogations motivées aux pièces obligatoires.
  derogations    Json?
  valideParId    String?
  valideLe       DateTime?
  creePar        String
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
  archiveLe      DateTime?

  parties    TransactionPartie[]
  pieces     TransactionPiece[]
  evenements TransactionEvenement[]
  paiements  TransactionPaiement[]
  formalites TransactionFormalite[]
  biens      TransactionBien[]
  demarches  Demarche[]
  echeances  TransactionEcheance[]
  etatsLieux EtatLieux[]

  @@index([dossierId])
  @@index([statut])
  @@index([typeId])
  @@map("transactions")
}

/// Bien rattaché à une transaction (principal ou annexe — un mandat de
/// gestion peut couvrir plusieurs biens).
model TransactionBien {
  id            String      @id @default(uuid())
  transactionId String
  transaction   Transaction @relation(fields: [transactionId], references: [id], onDelete: Cascade)
  bienId        String
  bien          Bien        @relation(fields: [bienId], references: [id])
  /// PRINCIPAL | ANNEXE
  role          String      @default("PRINCIPAL")
  createdAt     DateTime    @default(now())

  @@unique([transactionId, bienId])
  @@index([bienId])
  @@map("transaction_biens")
}

/// Partie à la transaction : vendeur, acheteur, bailleur, locataire,
/// garant, mandant… Le cabinet n'y figure jamais comme partie au contrat.
model TransactionPartie {
  id            String      @id @default(uuid())
  transactionId String
  transaction   Transaction @relation(fields: [transactionId], references: [id], onDelete: Cascade)
  /// VENDEUR | ACHETEUR | BAILLEUR | LOCATAIRE | GARANT | MANDANT |
  /// MANDATAIRE | NOTAIRE | BENEFICIAIRE | AUTRE
  role          String
  /// Lien vers une fiche demandeur réutilisable (personne identifiée).
  demandeurId   String?
  demandeur     Demandeur?  @relation(fields: [demandeurId], references: [id])
  /// Lien vers un client du cabinet, le cas échéant.
  clientId      String?
  client        Client?     @relation(fields: [clientId], references: [id])
  /// Identification libre quand ni demandeur ni client.
  nomLibre      String?
  coordonnees   String?
  qualite       String?
  representePar String?
  ordre         Int         @default(0)
  createdAt     DateTime    @default(now())

  @@index([transactionId])
  @@index([demandeurId])
  @@map("transaction_parties")
}

/// Ligne de check-list matérialisée sur une transaction.
model TransactionPiece {
  id            String      @id @default(uuid())
  transactionId String
  transaction   Transaction @relation(fields: [transactionId], references: [id], onDelete: Cascade)
  code          String
  libelle       String
  categorie     String
  /// OBLIGATOIRE | CONDITIONNELLE | FACULTATIVE
  niveau        String   @default("OBLIGATOIRE")
  condition     String?
  partieConcernee String @default("TOUTES")
  sourceAttendue  String @default("CLIENT")
  /// NON_DEMANDEE | DEMANDEE | RECUE | ILLISIBLE | EXPIREE |
  /// VALIDEE | NON_APPLICABLE | REJETEE
  statut        String   @default("NON_DEMANDEE")
  documentId    String?
  recueLe       DateTime?
  verifiePar    String?
  verifieLe     DateTime?
  expireLe      DateTime?
  commentaire   String?
  visibleClient Boolean  @default(false)
  ordre         Int      @default(0)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@index([transactionId])
  @@map("transaction_pieces")
}

/// Formalité externe suivie dans le cadre d'une transaction (étude
/// notariale, Conservation, Enregistrement, Cadastre, Domaines, banque,
/// géomètre…). Quand la formalité est une démarche administrative, elle
/// est portée par une `Demarche` liée via `demarcheId`.
model TransactionFormalite {
  id            String      @id @default(uuid())
  transactionId String
  transaction   Transaction @relation(fields: [transactionId], references: [id], onDelete: Cascade)
  /// NOTAIRE | DGID_CADASTRE | DGID_DOMAINES | DGID_ENREGISTREMENT |
  /// DGID_CONSERVATION | CSF | DGID_DIGITALE | MAIRIE | URBANISME |
  /// GEOMETRE | ARCHITECTE | HUISSIER | BANQUE_SEQUESTRE | ETAT_CIVIL |
  /// RCCM | JUSTICE | AUTRE
  entite        String
  bureau        String?     // étude notariale, bureau territorialement compétent
  objet         String
  /// OBLIGATOIRE | CONDITIONNELLE | RECOMMANDEE
  niveauObligation String  @default("CONDITIONNELLE")
  /// BROUILLON | A_PREPARER | PIECES_MANQUANTES | PRET_A_DEPOT | DEPOSE |
  /// DEPOT_A_CONFIRMER | COMPLEMENT_DEMANDE | EN_INSTRUCTION | RELANCE |
  /// ACCEPTE | REFUSE | EXPIRE | CLOTURE
  statut        String      @default("BROUILLON")
  /// Démarche administrative portant cette formalité, le cas échéant.
  demarcheId    String?
  demarche      Demarche?   @relation(fields: [demarcheId], references: [id])
  canalDepot    String?
  deposePar     String?
  dateDepot     DateTime?
  numeroRecepisse String?
  quittance     String?
  echeanceReponse DateTime?
  prochaineRelance DateTime?
  decisionDate  DateTime?
  documentReponseId String?
  notes         String?
  creePar       String
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  paiements     TransactionPaiement[]

  @@index([transactionId])
  @@index([statut])
  @@map("transaction_formalites")
}

/// Flux financier tracé sur une transaction : prix, loyers, dépôts,
/// frais reversés et honoraires — chaque ligne indique le bénéficiaire
/// réel. Les sommes destinées au notaire / à l'administration ne sont
/// jamais des honoraires du cabinet.
model TransactionPaiement {
  id            String      @id @default(uuid())
  transactionId String
  transaction   Transaction @relation(fields: [transactionId], references: [id], onDelete: Cascade)
  /// PRIX_DE_VENTE | DEPOT_GARANTIE | LOYER | AVANCE_LOYER | FRAIS_NOTAIRE |
  /// DROITS_ENREGISTREMENT | DROITS_PUBLICITE_FONCIERE | FRAIS_CADASTRE |
  /// FRAIS_DOMAINES | FRAIS_GEOMETRE | FRAIS_HUISSIER | FRAIS_URBANISME |
  /// FRAIS_BANCAIRES_OU_SEQUESTRE | HONORAIRES_CABINET | DEBOURS_CABINET |
  /// REMBOURSEMENT_CLIENT
  nature        String
  libelle       String?
  montant       Int
  devise        String      @default("XOF")
  payeur        String?     // nom du payeur
  beneficiaire  String?     // bénéficiaire réel
  /// ESPECE | VIREMENT | CHEQUE | MOBILE_MONEY | SEQUESTRE | AUTRE
  mode          String?
  date          DateTime    @default(now())
  /// Numéro de quittance / référence de virement.
  reference     String?
  /// Justificatif dans la GED du dossier.
  documentId    String?
  /// Rapprochement comptable effectué.
  rapproche     Boolean     @default(false)
  formaliteId   String?
  formalite     TransactionFormalite? @relation(fields: [formaliteId], references: [id])
  echeances     TransactionEcheance[]
  creePar       String?
  createdAt     DateTime    @default(now())

  @@index([transactionId])
  @@index([formaliteId])
  @@map("transaction_paiements")
}

/// Journal opérationnel de la transaction : signatures, transmissions,
/// dépôts, relances, paiements, décisions, changements de statut.
model TransactionEvenement {
  id            String      @id @default(uuid())
  transactionId String
  transaction   Transaction @relation(fields: [transactionId], references: [id], onDelete: Cascade)
  /// SIGNATURE | TRANSMISSION_NOTAIRE | DEPOT | RELANCE | COMPLEMENT |
  /// DECISION | PAIEMENT | REMISE | BLOCAGE | DEBLOCAGE | NOTE |
  /// CHANGEMENT_STATUT | VALIDATION | DEMANDE_PIECE
  type          String
  date          DateTime @default(now())
  description   String?
  details       Json?
  creePar       String?
  createdAt     DateTime @default(now())

  @@index([transactionId])
  @@index([date])
  @@map("transaction_evenements")
}

/// Modèle de document à variables ({{cle|Libellé}} / [Libellé]) rattaché
/// à un type de transaction : avant-contrats, contrats, mandats, états
/// des lieux, quittances, PV…
model TransactionModele {
  id      String           @id @default(uuid())
  code    String           @unique // TPL_*
  titre   String
  typeId  String?
  type    TransactionType? @relation(fields: [typeId], references: [id], onDelete: SetNull)
  /// JURISTE | AVOCAT | ASSISTANT — validation minimale exigée.
  validationMinimale String?
  contenu String           @db.Text
  ordre   Int              @default(0)
  actif   Boolean          @default(true)
  createdAt DateTime       @default(now())
  updatedAt DateTime       @updatedAt

  @@index([typeId])
  @@map("transaction_modeles")
}

/// Échéance de loyer / charges / reversement bailleur (baux et gestion locative).
/// Générées automatiquement à la création du bail (jour d'échéance, durée).
model TransactionEcheance {
  id            String      @id @default(uuid())
  transactionId String
  transaction   Transaction @relation(fields: [transactionId], references: [id], onDelete: Cascade)
  /// LOYER | CHARGES | REVERSEMENT_BAILLEUR | AUTRE
  nature        String      @default("LOYER")
  /// Premier jour du mois de la période (ex. nov. 2026 → 2026-11-01).
  periode       DateTime
  /// Jour d'échéance dans le mois (ex. le 5).
  jourEcheance  Int?
  montantDu     Int
  montantPaye   Int         @default(0)
  /// A_PERCEVOIR | PARTIEL | PAYE | EN_RETARD | ANNULE
  statut        String      @default("A_PERCEVOIR")
  payeLe        DateTime?
  /// ESPECE | VIREMENT | CHEQUE | MOBILE_MONEY | AUTRE
  modePaiement  String?
  /// Bénéficiaire réel (nom du propriétaire pour un reversement).
  beneficiaire  String?
  /// Paiement constaté dans TransactionPaiement.
  paiementId    String?
  paiement      TransactionPaiement? @relation(fields: [paiementId], references: [id])
  note          String?
  creePar       String?
  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt

  @@index([transactionId])
  @@index([statut])
  @@map("transaction_echeances")
}

/// État des lieux d'un bail : une fiche par transaction, lignes à double
/// entrée (entrée / sortie) inspirées du tableau GESTIMMO.
model EtatLieux {
  id            String      @id @default(uuid())
  transactionId String
  transaction   Transaction @relation(fields: [transactionId], references: [id], onDelete: Cascade)
  /// VIDE | MEUBLEE
  typeLocation  String      @default("VIDE")
  /// BROUILLON | FINALISE_ENTREE | FINALISE_SORTIE | CLOTURE
  statut        String      @default("BROUILLON")
  dateEntree    DateTime?
  dateSortie    DateTime?
  nbCles        Int?
  nbPieces      Int?
  etage         String?
  surface       Float?
  dependances   String?
  compteurEau   String?
  compteurElectricite String?
  /// Représentant du bailleur ou du locataire le cas échéant.
  representant  String?
  observations  String?
  /// PDF versé dans la GED du dossier.
  documentId    String?
  creePar       String?
  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt

  lignes        EtatLieuxLigne[]

  @@index([transactionId])
  @@map("etats_lieux")
}

model EtatLieuxLigne {
  id          String   @id @default(uuid())
  etatLieuxId String
  etatLieux   EtatLieux @relation(fields: [etatLieuxId], references: [id], onDelete: Cascade)
  ordre       Int      @default(0)
  /// Porte, Fenêtre, Mur, Plafond, Sol, Prise, Interrupteur, Robinet,
  /// Lavabo, WC, Douche, Baignoire, Meuble, Climatiseur, Plaque de
  /// cuisson, Four, Évier, Serrure, Autre.
  objet       String
  /// Salon 1 RDC, Salon 2 Étage, Chambre 1..5, Cuisine, Salle de bains,
  /// WC, Entrée, Couloir, Balcon, Terrasse, Cave, Garage…
  emplacement String?
  /// MOBILIER | SANITAIRE | ELECTRIQUE | MENUISERIE | PEINTURE | SOL |
  /// EQUIPEMENT | ACCESSOIRE
  typeElement String?
  quantiteEntree Int?  @default(1)
  /// NEUF | BON | MOYEN | USE | DEGRADE | CASSE
  etatEntree  String?
  obsEntree   String?
  quantiteSortie Int?
  etatSortie  String?
  obsSortie   String?

  @@index([etatLieuxId])
  @@map("etats_lieux_lignes")
}

// -------------------------------------------------------------------
// Parcours procédural : instances, décisions et voies de recours
// (appel devant la Cour d'appel, pourvoi devant la Cour suprême).
// -------------------------------------------------------------------

/// Niveau de juridiction saisi pour un dossier : première instance,
/// appel, pourvoi, opposition, révision ou exécution. Chaque procédure
/// porte sa juridiction, ses audiences (via les événements du dossier),
/// sa décision et le point de départ des délais de recours.
model Procedure {
  id                String   @id @default(uuid())
  dossierId         String
  dossier           Dossier  @relation(fields: [dossierId], references: [id], onDelete: Cascade)
  /// "premiere_instance" | "appel" | "pourvoi" | "opposition" | "revision" | "execution"
  niveau            String
  /// Ex. "Tribunal de grande instance de Dakar", "Cour d'appel de Dakar", "Cour suprême"
  juridiction       String
  chambre           String?
  greffe            String?
  /// Numéro de rôle / RG / enregistrement au greffe.
  referenceRg       String?
  dateSaisine       DateTime?
  datePrononce      DateTime?
  dateSignification DateTime?
  /// "jugement" | "ordonnance" | "arret"
  typeDecision      String?
  /// Dispositif / résumé de la décision rendue.
  decision          String?
  /// "favorable" | "defavorable" | "mixte" | "neutre" | "en_attente"
  sensDecision      String   @default("en_attente")
  /// "EN_COURS" | "DELIBERE" | "DECISION_RENDUE" | "DECISION_SIGNIFIEE" |
  /// "TRANSMIS_RECOURS" | "DEFINITIF" | "ARCHIVE"
  statut            String   @default("EN_COURS")
  /// Visible dans l'espace client (sans les notes internes).
  publieClient      Boolean  @default(true)
  notes             String?
  creePar           String?
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt
  recoursExerces    Recours[]            @relation("RecoursOrigine")
  recoursSource     Recours[]            @relation("RecoursCible")
  evenements        ProcedureEvenement[]

  @@index([dossierId])
  @@index([niveau])
  @@index([statut])
  @@map("procedures")
}

/// Journal des événements d'une procédure (saisine, audiences reportées
/// au calendrier, prononcé, signification, notes).
model ProcedureEvenement {
  id          String    @id @default(uuid())
  procedureId String
  procedure   Procedure @relation(fields: [procedureId], references: [id], onDelete: Cascade)
  /// "SAISINE" | "DECISION" | "SIGNIFICATION" | "CHANGEMENT_STATUT" | "NOTE"
  type        String
  description String
  date        DateTime  @default(now())
  details     Json?
  creePar     String?
  createdAt   DateTime  @default(now())

  @@index([procedureId])
  @@index([date])
  @@map("procedure_evenements")
}

/// Voie de recours contre la décision d'une procédure : appel, pourvoi
/// en cassation, opposition, révision. Porte le délai calculé, les actes
/// de forme (déclaration, signification, consignation, mémoire) et le
/// workflow d'états (voir `RECOURS_TRANSITIONS` dans lib/recours.ts).
model Recours {
  id                 String     @id @default(uuid())
  dossierId          String
  dossier            Dossier    @relation(fields: [dossierId], references: [id], onDelete: Cascade)
  procedureOrigineId String
  procedureOrigine   Procedure  @relation("RecoursOrigine", fields: [procedureOrigineId], references: [id])
  /// Procédure créée devant la juridiction du recours (remplie à l'enregistrement).
  procedureCibleId   String?
  procedureCible     Procedure? @relation("RecoursCible", fields: [procedureCibleId], references: [id])
  /// "appel" | "pourvoi" | "opposition" | "revision" | "autre"
  typeRecours        String
  /// "client" | "partie_adverse" | "ministere_public"
  origine            String     @default("client")
  juridictionCible   String?
  /// Point de départ du délai : "prononce" | "signification".
  pointDepart        String?
  /// Durée du délai en jours (calculée selon la matière, surchargeable).
  delaiJours         Int?
  /// Date servant de base au calcul (prononcé ou signification).
  dateReference      DateTime?
  /// Date limite d'exercice du recours.
  dateLimite         DateTime?
  dateDeclaration    DateTime?
  dateSignification  DateTime?
  dateConsignation   DateTime?
  dateMemoire        DateTime?
  /// Machine à états : A_ANALYSER → … → JUGE → EXECUTION_RENOI | ARCHIVE
  statut             String     @default("A_ANALYSER")
  /// Issue : "confirmatif" | "infirmatif" | "reformat_partiel" |
  /// "cassation_sans_renvoi" | "cassation_avec_renvoi" | "cassation_partielle" |
  /// "rejet" | "irrecevable" | "caduc" | "non_lieu" | "desistement"
  issue              String?
  avocatId           String?
  notes              String?
  creePar            String?
  createdAt          DateTime   @default(now())
  updatedAt          DateTime   @updatedAt
  evenements         RecoursEvenement[]

  @@index([dossierId])
  @@index([procedureOrigineId])
  @@index([statut])
  @@index([dateLimite])
  @@map("recours")
}

/// Journal de traçabilité des transitions d'un recours
/// (utilisateur, date, ancien état, nouvel état, motif).
model RecoursEvenement {
  id          String   @id @default(uuid())
  recoursId   String
  recours     Recours  @relation(fields: [recoursId], references: [id], onDelete: Cascade)
  /// "TRANSITION" | "NOTE" | "ECHEANCE"
  type        String   @default("TRANSITION")
  ancienStatut String?
  nouveauStatut String?
  description String
  details     Json?
  creePar     String?
  createdAt   DateTime @default(now())

  @@index([recoursId])
  @@index([createdAt])
  @@map("recours_evenements")
}
