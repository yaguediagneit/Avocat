  createdAt     DateTime @default(now()) @map("created_at")
  updatedAt     DateTime @updatedAt @map("updated_at")

  payrolls          Payroll[]
  histories         EmployeeHistory[]
  leaveRequests     LeaveRequest[]
  leaveTransactions LeaveTransaction[]
  leaveSetting      EmployeeLeaveSetting?
  insuredEmployees    InsuredEmployee[]
  insuranceDependents EmployeeDependent[]
  contracts           EmploymentContract[]
  socialPayments      SocialPayment[]
  @@map("employees")
}

model EmployeeHistory {
  id          String   @id @default(uuid())
  employeeId  String   @map("employee_id")
  employee    Employee @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  field       String
  oldValue    String?  @map("old_value")
  newValue    String?  @map("new_value")
  changedBy   String?  @map("changed_by")
  changedAt   DateTime @default(now()) @map("changed_at")
  createdAt   DateTime @default(now()) @map("created_at")

  @@index([employeeId, field, changedAt])
  @@map("employee_history")
}

/// Contrat de travail liant un employé au cabinet.
model EmploymentContract {
  id                    String   @id @default(uuid())
  employeeId            String   @map("employee_id")
  employee              Employee @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  typeContrat           String   @map("type_contrat")
  dateDebut             DateTime @map("date_debut") @db.Date
  dateFin               DateTime? @map("date_fin") @db.Date
  dureeMois             Int?     @map("duree_mois")
  fonction              String?
  service               String?
  lieuTravail           String?  @map("lieu_travail")
  horaires              String?
  salaireBase           Int      @map("salaire_base")
  periodeEssaiJours     Int?     @map("periode_essai_jours")
  congesPayesAnnuel     Int      @default(0) @map("conges_payes_annuel")
  conventionCollective  String?  @map("convention_collective")
  clauseConfidentialite Boolean  @default(false) @map("clause_confidentialite")
  clauseNonConcurrence  Boolean  @default(false) @map("clause_non_concurrence")
  objet                 String?
