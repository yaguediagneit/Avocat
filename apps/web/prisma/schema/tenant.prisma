  validatedAt   DateTime? @map("validated_at")
  createdBy     String?  @map("created_by")
  createdAt     DateTime @default(now()) @map("created_at")
  updatedAt     DateTime @updatedAt @map("updated_at")
  lines         AccountingEntryLine[]
  insuranceAdvances InsurerPayment[]

  @@unique([tenantId, idempotencyKey])
  @@index([tenantId])
  @@index([tenantId, journalId])
  @@index([tenantId, exerciseId])
  @@index([tenantId, entryDate])
  @@index([reference])
  @@index([isValidated])
  @@map("accounting_entries")
}

model AccountingEntryLine {
  id             String  @id @default(uuid())
  tenantId       String  @map("tenant_id")
  entryId        String  @map("entry_id")
  entry          AccountingEntry @relation(fields: [entryId], references: [id], onDelete: Cascade)
  accountId      String  @map("account_id")
  account        AccountingAccount @relation(fields: [accountId], references: [id])
  debit          Int   @default(0)
  credit         Int   @default(0)
  libelle        String?
  thirdPartyType String? @map("third_party_type")
  thirdPartyId   String? @map("third_party_id")
  reference      String?
  createdAt      DateTime @default(now()) @map("created_at")

  @@index([tenantId])
  @@index([tenantId, entryId])
  @@index([tenantId, accountId])
  @@map("accounting_entry_lines")
}

model AccountingTax {
  id        String  @id @default(uuid())
  code      String
  label     String
  rate      Float   @default(0)
  accountId String? @map("account_id")
  isActive  Boolean @default(true) @map("is_active")
  createdAt DateTime @default(now()) @map("created_at")

  @@index([code])
  @@map("accounting_taxes")
}

model AccountMapping {
  id          String   @id @default(uuid())
  code        String   @unique
  label       String
  accountCode String   @map("account_code")
  journalCode String?  @map("journal_code")
  isActive    Boolean  @default(true) @map("is_active")
