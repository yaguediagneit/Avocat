  createdAt             DateTime @default(now()) @map("created_at")
  updatedAt             DateTime @updatedAt @map("updated_at")

  @@index([employeeId])
  @@index([statut])
  @@index([approbateurId])
  @@map("employment_contracts")
}

model PayrollRubric {
  id           String   @id @default(uuid())
  code         String   @unique
  label        String
  type         String
  calcType     String   @map("calc_type")
  rateOrAmount Float    @map("rate_or_amount")
  sortOrder    Int      @map("sort_order")
  isActive     Boolean  @default(true) @map("is_active")
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")

  lines PayrollLine[]
  @@map("payroll_rubrics")
}

/// Règles de cotisation par régime, organisme, plafond et période.
/// Permet de gérer IPRES, CSS, accidents du travail, prestations familiales, etc.
model PayrollContributionRule {
  id            String   @id @default(uuid())
  code          String
  regime        String   @default("general")
  label         String
  organism      String?  @map("organism")
  branch        String?  @map("branch")
  employeeRate  Float    @map("employee_rate")
  employerRate  Float    @map("employer_rate")
  monthlyCeiling Int?    @map("monthly_ceiling")
  effectiveFrom DateTime @map("effective_from")
  effectiveTo   DateTime? @map("effective_to")
  accountEmployee String? @map("account_employee")
  accountEmployer String? @map("account_employer")
  isActive      Boolean  @default(true) @map("is_active")
  createdAt     DateTime @default(now()) @map("created_at")
  updatedAt     DateTime @updatedAt @map("updated_at")

  @@index([code, regime, effectiveFrom])
  @@index([isActive, effectiveFrom, effectiveTo])
  @@map("payroll_contribution_rules")
}

/// Versements sociaux et fiscaux à approuver avant règlement.
/// IRPP, IPRES, CNSS/CSS, Assurance.
model SocialPayment {
  id                String    @id @default(uuid())
  type              String    // IRPP | IPRES | CNSS_CSS | ASSURANCE
  periodYear        Int       @map("period_year")
  periodMonth       Int?      @map("period_month")
  periodStart       DateTime? @map("period_start")
  periodEnd         DateTime? @map("period_end")
  employeeId        String    @map("employee_id")
  employee          Employee  @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  employeeNumber    String?   @map("employee_number")
  amount            Int
  preparedBy        String    @map("prepared_by")
  preparedAt        DateTime  @default(now()) @map("prepared_at")
  status            String    @default("draft") @map("status") // draft | approved | rejected
  approvedBy        String?   @map("approved_by")
  approvedAt        DateTime? @map("approved_at")
  accountingEntryId String?   @map("accounting_entry_id")
  createdAt         DateTime  @default(now()) @map("created_at")
  updatedAt         DateTime  @updatedAt @map("updated_at")

  @@index([status])
  @@index([periodYear, periodMonth])
  @@index([employeeId, type])
  @@map("social_payments")
}

model Payroll {
  id                  String   @id @default(uuid())
  employeeId          String   @map("employee_id")
