  periodYear          Int      @map("period_year")
  periodMonth         Int      @map("period_month")
  baseSalary          Int    @map("base_salary")
  grossSalary         Int    @map("gross_salary")
  totalGains          Int    @map("total_gains")
  totalDeductions     Int    @map("total_deductions")
  totalCotisations    Int    @map("total_cotisations")
  cssBase             Int    @map("css_base")
  cssRate             Float    @map("css_rate")
  cssAmount           Int    @map("css_amount")
  cssEmployerAmount   Int    @map("css_employer_amount")
  ipresBase           Int    @map("ipres_base")
  ipresRate           Float    @map("ipres_rate")
  ipresAmount         Int    @map("ipres_amount")
  ipresEmployerAmount Int    @map("ipres_employer_amount")
  irppTaxableBase     Int    @map("irpp_taxable_base")
  irppShares          Float    @map("irpp_shares")
  irppAmount          Int    @map("irpp_amount")
  netSalary           Int    @map("net_salary")
  totalEmployerCost   Int    @map("total_employer_cost")
  status              String   @default("draft")
  signedDocumentUrl   String?  @map("signed_document_url")
  notes               String?
  paidAt              DateTime? @map("paid_at")
  accountingEntryId   String?  @map("accounting_entry_id")
  createdBy           String?  @map("created_by")
  createdAt           DateTime @default(now()) @map("created_at")
  updatedAt           DateTime @updatedAt @map("updated_at")

  lines PayrollLine[]
  @@unique([employeeId, periodYear, periodMonth])
  @@map("payrolls")
}

model PayrollLine {
  id             String        @id @default(uuid())
  payrollId      String        @map("payroll_id")
  payroll        Payroll       @relation(fields: [payrollId], references: [id], onDelete: Cascade)
  rubricId       String        @map("rubric_id")
  rubric         PayrollRubric @relation(fields: [rubricId], references: [id])
  rubricCode     String        @map("rubric_code")
  rubricLabel    String        @map("rubric_label")
  rubricType     String        @map("rubric_type")
  calcType       String        @map("calc_type")
  rateOrAmount   Float         @map("rate_or_amount")
  baseAmount     Int         @map("base_amount")
  computedAmount Int        @map("computed_amount")
  sortOrder      Int           @map("sort_order")
  createdAt      DateTime      @default(now()) @map("created_at")

  @@index([payrollId])
  @@map("payroll_lines")
}

/// Demandes déposées par les clients ou prospects.
model ClientRequest {
  id          String   @id @default(uuid())
  /// "info" | "dossier" | "rendezvous" | "document" | "autre"
  type        String
  subject     String
  description String?
  /// "nouvelle" | "en_cours" | "traite" | "archive"
  status      String   @default("nouvelle")
  clientId    String?  @map("client_id")
  requesterName  String?  @map("requester_name")
  requesterPhone String?  @map("requester_phone")
  requesterEmail String?  @map("requester_email")
  requestDate DateTime? @map("request_date")
  /// "en_attente" | "repondu"
  responseStatus String?  @map("response_status")
  responseDate  DateTime? @map("response_date")
  responseDetail String?  @map("response_detail")
  createdBy   String?  @map("created_by")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  @@index([clientId])
  @@index([status])
  @@index([type])
  @@map("client_requests")
}

/// Registre des appels (entrants / sortants).
model CallLog {
