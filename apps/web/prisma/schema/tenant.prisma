generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL_TENANT_TEMPLATE")
}

model User {
  id              String    @id @default(uuid())
  email           String    @unique
  passwordHash    String
  prenom          String
  nom             String
  titre           String?
  specialite      String?
  signatureKey    String?
  roleId          String
  clientId        String?
  mfaSecret       String?
  mfaEnabled      Boolean   @default(false)
  actif           Boolean   @default(true)
  derniereConnexion DateTime?
  derniereIp      String?
  appareils       Json?
  calendarToken   String?   @unique @map("calendar_token")
  createdAt       DateTime  @default(now())
  role            Role      @relation(fields: [roleId], references: [id])
  evenementsCrees Evenement[] @relation("EvenementCreateur")
  contractsToApprove EmploymentContract[] @relation("ContractApprobateur")

  @@map("users")
}

model Role {
  id                      String   @id @default(uuid())
  nom                     String   @unique
  permissions             Json
  estAdmin                Boolean  @default(false)
  estClient               Boolean  @default(false)
  niveauConfidentialiteMax Int     @default(0)
  actif                   Boolean  @default(true)
  users                   User[]

  @@map("roles")
}

model PermissionDossier {
  id        String   @id @default(uuid())
  dossierId String
  userId    String
  niveau    String
  createdAt DateTime @default(now())

  @@map("permissions_dossier")
}

model Client {
  id              String   @id @default(uuid())
  type            String
  raisonSociale   String
  identifiant     String?
  adresse         String?
  coordonnees     Json?
  representants   Json?
  billingInfo     Json?
  consentements   Json?
  documentsAdmin  Json?
  actif           Boolean  @default(true)
  createdAt       DateTime @default(now())
  dossiers        Dossier[]
  factures        Facture[]
  demandeurs      Demandeur[]
  transactionParties TransactionPartie[]

  @@map("clients")
}

model Dossier {
  id                    String   @id @default(uuid())
  referenceInterne      String   @unique
  typeAffaire           String
  /// Natures de mission du dossier : tableau de codes (paramètre `nature_mission`).
  /// Les anciennes lignes peuvent contenir une simple chaîne — voir `naturesMissionOf`.
  natureMission         Json
  /// Matière juridique : "civil" | "commercial" | "social" | "penal" |
  /// "administratif" | "fiscal" — pilote les délais de recours (voir lib/recours.ts).
  matiere               String?
  clientId              String
  client                Client   @relation(fields: [clientId], references: [id])
  partiesAdverses       Json?
  juridictionId         String?
  avocatResponsableId   String
  huissierResponsableId String?
  /// Utilisateur ayant créé le dossier (accès dossier + partage client).
  createurId            String?
  /// Dossier partagé avec le client (espace client) par le créateur/responsable/admin.
  partageClient         Boolean  @default(false)
  collaborateurs        Json?
  dateOuverture         DateTime @default(now())
  niveauConfidentialite Int      @default(1)
  statut                String   @default("Nouveau")
  dateEcheance          DateTime?
  actif                 Boolean  @default(true)
  createdAt             DateTime @default(now())
  documents             Document[]
  taches                Tache[]
  evenements            Evenement[]
  missions              MissionHuissier[]
  missionsArchitecte    MissionArchitecte[]
  missionsConseillerJuridique MissionConseillerJuridique[]
  missionsClerc         MissionClerc[]
  factures              Facture[]
  charges               Charge[]
  conflitsInteret       ConflitInteret[] @relation("ConflitDossierSource")
  conflitsCibles        ConflitInteret[] @relation("ConflitDossierCible")
  commentaires          CommentaireDossier[]
  collaborateursRACI    DossierCollaborateur[]
  checklistItems        ChecklistCloture[]
  demarches             Demarche[]
  transactions          Transaction[]
  procedures            Procedure[]
  recours               Recours[]

  @@map("dossiers")
}

/// Fil de discussion attaché à un dossier.
/// Toutes les communications internes restent ici au lieu d'être dispersées dans des emails.
model CommentaireDossier {
  id         String   @id @default(uuid())
  dossierId  String
  dossier    Dossier  @relation(fields: [dossierId], references: [id], onDelete: Cascade)
  auteurId   String
  auteurNom  String
  message    String
  /// "commentaire" | "decision" | "note_interne"
  type       String   @default("commentaire")
  luPar      Json?
  createdAt  DateTime @default(now())

  @@index([dossierId])
  @@index([createdAt])
  @@map("commentaires_dossier")
}

/// Matrice RACI : multi-contributeurs par dossier avec rôles définis.
/// R = Responsable, A = Approuve, C = Consulté, I = Informé
model DossierCollaborateur {
  id         String   @id @default(uuid())
  dossierId  String
  dossier    Dossier  @relation(fields: [dossierId], references: [id], onDelete: Cascade)
  userId     String
  /// "R" | "A" | "C" | "I"
  roleRACI   String
  /// Type d'intervention : "avocat", "huissier", "juriste", "notaire", "expert_comptable", "assistant", "greffier"
  discipline String?
  /// Tâches attendues de cet intervenant : tableau de titres de `TacheTemplate`
  /// de la spécialité du dossier. Les anciennes lignes peuvent contenir une
  /// simple chaîne — normaliser avec `stringListOf`.
  tacheAttendue Json?
  createdAt  DateTime @default(now())

  @@unique([dossierId, userId])
  @@index([dossierId])
  @@map("dossier_collaborateurs")
}

/// Check-list de clôture : items à vérifier avant de clôturer un dossier.
model ChecklistCloture {
  id         String   @id @default(uuid())
  dossierId  String
  dossier    Dossier  @relation(fields: [dossierId], references: [id], onDelete: Cascade)
  libelle    String
  ordre      Int      @default(0)
  coche      Boolean  @default(false)
  cochePar   String?
  cocheLe    DateTime?
  createdAt  DateTime @default(now())

  @@index([dossierId])
  @@map("checklist_cloture")
}

/// Notifications / rappels persistants générés automatiquement.
/// Permet de configurer des rappels J-7, J-3, J-1 sur les échéances.
model Notification {
  id         String   @id @default(uuid())
  userId     String
  dossierId  String?
  type       String
  titre      String
  message    String
  /// "info" | "warning" | "urgent"
  severite   String   @default("info")
  lu         Boolean  @default(false)
  luLe       DateTime?
  dateDeclenchement DateTime @default(now())
  createdAt  DateTime @default(now())

  @@index([userId, lu])
  @@index([dossierId])
  @@map("notifications")
}

/// Vérification de conflits d'intérêts entre dossiers.
/// Détecte automatiquement les chevauchements de clients / parties adverses
/// avant l'ouverture d'un dossier.
model ConflitInteret {
  id               String   @id @default(uuid())
  dossierId        String
  dossier          Dossier  @relation("ConflitDossierSource", fields: [dossierId], references: [id], onDelete: Cascade)
  dossierConflitId String
  dossierConflit   Dossier  @relation("ConflitDossierCible", fields: [dossierConflitId], references: [id])
  /// "client_commun" | "partie_adverse_commune" | "client_vs_partie_adverse"
  typeConflit      String
  details          Json?
  /// "detecte" | "valide" | "ignore" | "resolu"
  statut           String   @default("detecte")
  validePar        String?
  dateVerification DateTime?
  note             String?
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  @@index([dossierId])
  @@index([dossierConflitId])
  @@index([statut])
  @@map("conflits_interet")
}

model DossierImmobilier {
  dossierId          String  @id
  adresseBien        String?
  titreFoncier       String?
  natureBien         String?
  proprietaire       String?
  occupant           String?
  montantLitige      Int?
  expertId           String?
  notaireId          String?
  documentsPropriete Json?

  @@map("dossiers_immobiliers")
}

model Document {
  id              String   @id @default(uuid())
  dossierId       String
  dossier         Dossier  @relation(fields: [dossierId], references: [id])
  nom             String
  categorie       String
  s3KeyChiffre    String
  hashSha256      String
  taille          Int
  versionCourante Int      @default(1)
  publieClient    Boolean  @default(false)
  /// Partage avec les intervenants externes du dossier (huissier, collaborateurs externes).
  partageExterne  Boolean  @default(false)
  datePublication DateTime?
  dateExpiration  DateTime?
  creePar         String
  validePar       String?
  metadata        Json?
  /// Workflow de validation des actes : "brouillon" | "en_relecture" | "valide" | "rejete"
  statutValidation String  @default("brouillon")
  relecteurId     String?
  dateRelecture   DateTime?
  /// Circuit de validation : [{ role: "redacteur", userId: "...", date: "..." }, ...]
  circuitValidation Json?
  actif           Boolean  @default(true)
  createdAt       DateTime @default(now())
  versions        VersionDocument[]

  @@map("documents")
}

model VersionDocument {
  id           String   @id @default(uuid())
  documentId   String
  document     Document @relation(fields: [documentId], references: [id])
  s3KeyChiffre String
  numeroVersion Int
  hashSha256   String
  creePar      String
  createdAt    DateTime @default(now())

  @@map("versions_document")
}

model Tache {
  id            String   @id @default(uuid())
  dossierId     String
  dossier       Dossier  @relation(fields: [dossierId], references: [id])
  titre         String
  description   String?
  responsableId String
  createurId    String
  echeance      DateTime?
  priorite      String   @default("moyenne")
  statut        String   @default("En cours")
  actif         Boolean  @default(true)
  checklist     Json?
  commentaires  Json?
  createdAt     DateTime @default(now())
  factures      Facture[]
  charges       Charge[]

  @@map("taches")
}

model Evenement {
  id              String    @id @default(uuid())
  createurId      String?
  createur        User?     @relation("EvenementCreateur", fields: [createurId], references: [id])
  dossierId       String?
  dossier         Dossier?  @relation(fields: [dossierId], references: [id])
  type            String
  titre           String
  dateDebut       DateTime
  dateFin         DateTime?
  lieu            String?
  participants    Json?
  commentaires    Json?
  estPublicClient Boolean   @default(false)
  actif           Boolean   @default(true)
  createdAt       DateTime  @default(now())

  @@map("evenements")
}

model MissionHuissier {
  id                   String   @id @default(uuid())
  dossierId            String
  dossier              Dossier  @relation(fields: [dossierId], references: [id])
  typeActe             String
  huissierId           String
  adresseSignification String?
  destinataire         String?
  datePrevue           DateTime?
  fraisDeplacement     Int?
  debours              Int?
  dateTentative        DateTime?
  dateRemise           DateTime?
  resultat             String?
  preuveRemiseKey      String?
  statut               String   @default("En préparation")
  retourKey            String?
  actif                Boolean  @default(true)
  createdAt            DateTime @default(now())
  factures             Facture[]
  charges              Charge[]

  @@map("missions_huissier")
}

model MissionArchitecte {
  id                   String   @id @default(uuid())
  dossierId            String
  dossier              Dossier  @relation(fields: [dossierId], references: [id])
  typeActe             String
  architecteId         String
  adresseSignification String?
  destinataire         String?
  datePrevue           DateTime?
  fraisDeplacement     Int?
  debours              Int?
  dateTentative        DateTime?
  dateRemise           DateTime?
  resultat             String?
  preuveRemiseKey      String?
  statut               String   @default("En préparation")
  retourKey            String?
  actif                Boolean  @default(true)
  createdAt            DateTime @default(now())

  @@map("missions_architecte")
}

model MissionConseillerJuridique {
  id                   String   @id @default(uuid())
  dossierId            String
  dossier              Dossier  @relation(fields: [dossierId], references: [id])
  typeActe             String
  conseillerJuridiqueId String
  adresseSignification String?
  destinataire         String?
  datePrevue           DateTime?
  fraisDeplacement     Int?
  debours              Int?
  dateTentative        DateTime?
  dateRemise           DateTime?
  resultat             String?
  preuveRemiseKey      String?
  statut               String   @default("En préparation")
  retourKey            String?
  actif                Boolean  @default(true)
  createdAt            DateTime @default(now())

  @@map("missions_conseiller_juridique")
}

model MissionClerc {
  id                   String   @id @default(uuid())
  dossierId            String
  dossier              Dossier  @relation(fields: [dossierId], references: [id])
  typeActe             String
  clercId              String
  adresseSignification String?
  destinataire         String?
  datePrevue           DateTime?
  fraisDeplacement     Int?
  debours              Int?
  dateTentative        DateTime?
  dateRemise           DateTime?
  resultat             String?
  preuveRemiseKey      String?
  statut               String   @default("En préparation")
  retourKey            String?
  actif                Boolean  @default(true)
  createdAt            DateTime @default(now())

  @@map("missions_clerc")
}

model Facture {
  id                 String     @id @default(uuid())
  dossierId          String?
  dossier            Dossier?   @relation(fields: [dossierId], references: [id])
  tacheId            String?    @map("tache_id")
  tache              Tache?     @relation(fields: [tacheId], references: [id])
  missionHuissierId  String?    @map("mission_huissier_id")
  missionHuissier    MissionHuissier? @relation(fields: [missionHuissierId], references: [id])
  clientId           String
  client             Client     @relation(fields: [clientId], references: [id])
  numero       String     @unique
  libelle      String?
  designation  String?
  intervenants Json?
  dateEmission DateTime   @default(now()) @map("date_emission")
  dateEcheance DateTime?  @map("date_echeance")
  honoraires   Json?
  debours      Int?
  frais        Int?
  totalHt      Int      @default(0) @map("total_ht")
  totalTva     Int      @default(0) @map("total_tva")
  totalTtc     Int
  statut       String     @default("Brouillon")
  actif        Boolean    @default(true)   @map("actif")
  tvaEnabled   Boolean    @default(false) @map("tva_enabled")
  tvaRateId    String?    @map("tva_rate_id")
  tvaRate      TvaRate?   @relation(fields: [tvaRateId], references: [id])
  paiements    Paiement[]
  lines        FactureLine[]
  accountingEntryId String? @map("accounting_entry_id")
  createdAt    DateTime   @default(now())

  @@index([tacheId])
  @@index([missionHuissierId])
  @@map("factures")
}

model FactureLine {
  id           String   @id @default(uuid())
  factureId    String   @map("facture_id")
  facture      Facture  @relation(fields: [factureId], references: [id], onDelete: Cascade)
  description  String
  quantite     Int    @default(1)
  prixUnitaire Int    @default(0) @map("prix_unitaire")
  tauxTva      Float    @default(0) @map("taux_tva")
  totalHt      Int    @default(0) @map("total_ht")
  totalTva     Int    @default(0) @map("total_tva")
  totalTtc     Int    @default(0) @map("total_ttc")
  ordre        Int      @default(0)
  createdAt    DateTime @default(now()) @map("created_at")

  @@index([factureId])
  @@map("facture_lines")
}

model TvaRate {
  id        String   @id @default(uuid())
  code      String   @unique
  label     String
  rate      Float
  isDefault Boolean  @default(false) @map("is_default")
  isActive  Boolean  @default(true) @map("is_active")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  factures  Facture[]
  charges   Charge[]
  @@map("tva_rates")
}

model Paiement {
  id           String   @id @default(uuid())
  factureId    String
  facture      Facture  @relation(fields: [factureId], references: [id])
  montant      Int
  datePaiement DateTime @default(now())
  mode         String
  reference    String?
  preuveKey    String?
  accountingEntryId String? @map("accounting_entry_id")
  createdAt    DateTime @default(now())

  @@map("paiements")
}

model ChargeCategory {
  id          String   @id @default(uuid())
  code        String   @unique
  label       String
  accountCode String?  @map("account_code")
  description String?
  isActive    Boolean  @default(true) @map("is_active")
  ordre       Int      @default(0)
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  charges Charge[]
  @@map("charge_categories")
}

model Charge {
  id                String          @id @default(uuid())
  categoryId        String          @map("category_id")
  category          ChargeCategory  @relation(fields: [categoryId], references: [id])
  dossierId         String?         @map("dossier_id")
  dossier           Dossier?        @relation(fields: [dossierId], references: [id])
  tacheId           String?         @map("tache_id")
  tache             Tache?          @relation(fields: [tacheId], references: [id])
  missionHuissierId String?         @map("mission_huissier_id")
  missionHuissier   MissionHuissier? @relation(fields: [missionHuissierId], references: [id])
  chargeDate        DateTime        @map("charge_date")
  amount            Int
  totalHt           Int?          @map("total_ht")
  taxAmount         Int?          @map("tax_amount")
  tvaEnabled        Boolean         @default(false) @map("tva_enabled")
  tvaRateId         String?         @map("tva_rate_id")
  tvaRate           TvaRate?        @relation(fields: [tvaRateId], references: [id])
  paymentMethod     String          @map("payment_method")
  description       String?
  supplierName      String?         @map("supplier_name")
  supplierInvoiceRef String?        @map("supplier_invoice_ref")
  attachmentKey     String?         @map("attachment_key")
  /// Immobilisation amortie : le bien est inscrit en classe 2 et la charge est
  /// répartie sur `immobilisationMonths` mois via des dotations (ChargeAmortissement).
  isImmobilisation  Boolean         @default(false) @map("is_immobilisation")
  /// Mode de calcul de la dotation : "montant" (montant mensuel fixe) ou "taux" (taux annuel).
  immobilisationMode String?        @map("immobilisation_mode")
  /// Taux d'amortissement annuel en % (mode "taux").
  immobilisationRate Float?         @map("immobilisation_rate")
  /// Durée d'amortissement en mois.
  immobilisationMonths Int?         @map("immobilisation_months")
  /// Compte d'immobilisation (classe 2) débité à l'acquisition.
  immobilisationAccountCode String? @map("immobilisation_account_code")
  /// Premier mois de dotation (par défaut le mois de la charge).
  amortissementStartDate DateTime?  @map("amortissement_start_date")
  /// Dotation mensuelle aux amortissements.
  monthlyPayment    Int?          @map("monthly_payment")
  amortissements    ChargeAmortissement[]
  status            String          @default("draft")
  isPaid            Boolean         @default(false) @map("is_paid")
  paidAt            DateTime?       @map("paid_at")
  accountingEntryId String?         @map("accounting_entry_id")
  actif             Boolean         @default(true) @map("actif")
  createdBy         String?         @map("created_by")
  createdAt         DateTime        @default(now()) @map("created_at")
  updatedAt         DateTime        @updatedAt @map("updated_at")
  /// Données complémentaires pour les fiches spécifiques (ex. paiement intervenant).
  metadata          Json?           @map("metadata")
  lines             ChargeLine[]

  @@index([categoryId])
  @@index([chargeDate])
  @@index([dossierId])
  @@index([tacheId])
  @@index([missionHuissierId])
  @@map("charges")
}

model ChargeLine {
  id           String  @id @default(uuid())
  chargeId     String  @map("charge_id")
  charge       Charge  @relation(fields: [chargeId], references: [id], onDelete: Cascade)
  description  String
  quantite     Int   @default(1)
  prixUnitaire Int   @default(0) @map("prix_unitaire")
  tauxTva      Float   @default(0) @map("taux_tva")
  totalHt      Int   @default(0) @map("total_ht")
  totalTva     Int   @default(0) @map("total_tva")
  totalTtc     Int   @default(0) @map("total_ttc")
  ordre        Int     @default(0)
  createdAt    DateTime @default(now()) @map("created_at")

  @@index([chargeId])
  @@map("charge_lines")
}

/// Plan d'amortissement d'une charge inscrite en immobilisation : une ligne par
/// mois de dotation. `isPosted` passe à true quand l'écriture
/// D 681x Dotations / C 28x Amortissements a été générée.
model ChargeAmortissement {
  id                String   @id @default(uuid())
  chargeId          String   @map("charge_id")
  charge            Charge   @relation(fields: [chargeId], references: [id], onDelete: Cascade)
  numero            Int
  periodYear        Int      @map("period_year")
  periodMonth       Int      @map("period_month")
  dueDate           DateTime @map("due_date")
  amount            Int
  /// Cumul des amortissements à la fin de la période.
  cumul             Int    @default(0)
  /// Valeur nette comptable à la fin de la période.
  vnc               Int    @default(0)
  isPosted          Boolean  @default(false) @map("is_posted")
  postedAt          DateTime? @map("posted_at")
  accountingEntryId String?  @map("accounting_entry_id")
  createdAt         DateTime @default(now()) @map("created_at")
  updatedAt         DateTime @updatedAt @map("updated_at")

  @@unique([chargeId, numero])
  @@index([chargeId])
  @@index([dueDate])
  @@index([isPosted])
  @@map("charge_amortissements")
}

model AuditLog {
  id        String   @id @default(uuid())
  userId    String?
  action    String
  entite    String
  entiteId  String?
  details   Json?
  adresseIp String?
  userAgent String?
  createdAt DateTime @default(now())

  @@index([createdAt])
  @@index([entite, entiteId])
  @@map("audit_logs")
}

model Parametre {
  id        String   @id @default(uuid())
  categorie String
  code      String
  libelle   String
  ordre     Int      @default(0)
  actif     Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([categorie, code])
  @@index([categorie])
  @@map("parametres")
}

model Specialite {
  id               String                   @id @default(uuid())
  code             String                   @unique
  libelle          String
  description      String?
  ordre            Int                      @default(0)
  selectionnee     Boolean                  @default(false)
  actif            Boolean                  @default(true)
  typesDocuments   TypeDocumentSpecialite[]
  workflowEtapes   WorkflowSpecialite[]
  tacheTemplates   TacheTemplate[]
  createdAt        DateTime                 @default(now())
  updatedAt        DateTime                 @updatedAt

  @@map("specialites")
}

model TypeDocumentSpecialite {
  id           String     @id @default(uuid())
  specialiteId String
  specialite   Specialite @relation(fields: [specialiteId], references: [id], onDelete: Cascade)
  code         String
  libelle      String
  description  String?
  obligatoire  Boolean    @default(false)
  ordre        Int        @default(0)
  actif        Boolean    @default(true)
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt

  @@unique([specialiteId, code])
  @@map("types_documents_specialite")
}

model WorkflowSpecialite {
  id           String     @id @default(uuid())
  specialiteId String
  specialite   Specialite @relation(fields: [specialiteId], references: [id], onDelete: Cascade)
  code         String
  libelle      String
  description  String?
  ordre        Int        @default(0)
  estInitial   Boolean    @default(false)
  estFinal     Boolean    @default(false)
  /// Statut du dossier à appliquer quand une mission d'huissier réalise cette étape.
  statutDossier String?
  actif        Boolean    @default(true)
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt

  tacheTemplates TacheTemplate[]

  @@unique([specialiteId, code])
  @@map("workflow_specialite")
}

/// Modèle de tâche pré-définie rattaché à une étape de workflow d'une spécialité.
/// À la création d'un dossier, les templates de la spécialité sélectionnée
/// génèrent automatiquement les tâches de démarrage.
model TacheTemplate {
  id                 String           @id @default(uuid())
  specialiteId       String
  specialite         Specialite       @relation(fields: [specialiteId], references: [id], onDelete: Cascade)
  workflowEtapeId    String?
  workflowEtape      WorkflowSpecialite? @relation(fields: [workflowEtapeId], references: [id], onDelete: SetNull)
  titre              String
  description        String?
  /// Modèle de document : texte fixe contenant des variables {{cle}} ou {{cle|Libellé}}
  /// substituées lors de la génération du PDF (formulaire structuré, texte non éditable).
  contenuDocument    String?          @db.Text
  /// Clé S3 du modèle Word (.docx) associé. Les variables {{cle}} dans le fichier
  /// Word sont substituées via docxtemplater lors de la génération.
  wordTemplateKey    String?
  /// Délai en jours à compter de l'ouverture du dossier pour calculer l'échéance
  delaiJours         Int              @default(0)
  /// Rôle attendu : "avocat", "huissier", "juriste", "assistant", "any"
  roleAttendu        String           @default("any")
  priorite           String           @default("moyenne")
  ordre              Int              @default(0)
  actif              Boolean          @default(true)
  createdAt          DateTime         @default(now())
  updatedAt          DateTime         @updatedAt

  @@index([specialiteId])
  @@index([workflowEtapeId])
  @@map("tache_templates")
}

model AccountingExercise {
  id        String   @id @default(uuid())
  label     String
  year      Int
  startDate DateTime @map("start_date")
  endDate   DateTime @map("end_date")
  status    String   @default("open")
  isClosed  Boolean  @default(false) @map("is_closed")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")
  entries   AccountingEntry[]

  @@index([year])
  @@index([status])
  @@map("accounting_exercises")
}

model AccountingAccount {
  id          String  @id @default(uuid())
  accountCode String  @unique @map("account_code")
  label       String
  class       Int
  subClass    Int     @map("sub_class")
  accountType String  @default("ACTIF") @map("account_type")
  level       Int     @default(1)
  parentId    String? @map("parent_id")
  parent      AccountingAccount?  @relation("AccountHierarchy", fields: [parentId], references: [id])
  children    AccountingAccount[] @relation("AccountHierarchy")
  soldeInitial Int  @default(0) @map("solde_initial")
  soldeActuel  Int  @default(0) @map("solde_actuel")
  isActive    Boolean @default(true) @map("is_active")
  isAuxiliary Boolean @default(false) @map("is_auxiliary")
  /// nature : "mouvementable" | "collectif" | "auxiliaire" | "regroupement" | "presentation"
  nature      String  @default("mouvementable") @map("nature")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  lines              AccountingEntryLine[]
  defaultDebitJournals  AccountingJournal[] @relation("DefaultDebitJournal")
  defaultCreditJournals AccountingJournal[] @relation("DefaultCreditJournal")

  @@index([class])
  @@index([subClass])
  @@index([parentId])
  @@index([isActive])
  @@map("accounting_accounts")
}

model AccountingJournal {
  id                     String  @id @default(uuid())
  code                   String  @unique
  label                  String
  journalType            String  @default("OD") @map("journal_type")
  defaultDebitAccountId  String? @map("default_debit_account_id")
  defaultCreditAccountId String? @map("default_credit_account_id")
  defaultDebitAccount    AccountingAccount? @relation("DefaultDebitJournal", fields: [defaultDebitAccountId], references: [id])
  defaultCreditAccount   AccountingAccount? @relation("DefaultCreditJournal", fields: [defaultCreditAccountId], references: [id])
  isActive               Boolean @default(true) @map("is_active")
  createdAt              DateTime @default(now()) @map("created_at")
  entries                AccountingEntry[]

  @@index([journalType])
  @@index([isActive])
  @@map("accounting_journals")
}

model AccountingEntry {
  id            String   @id @default(uuid())
  tenantId      String   @map("tenant_id")
  journalId     String   @map("journal_id")
  journal       AccountingJournal @relation(fields: [journalId], references: [id])
  exerciseId    String   @map("exercise_id")
  exercise      AccountingExercise @relation(fields: [exerciseId], references: [id])
  entryDate     DateTime @map("entry_date")
  reference     String?
  idempotencyKey String? @map("idempotency_key")
  libelle       String
  totalDebit    Int    @default(0) @map("total_debit")
  totalCredit   Int    @default(0) @map("total_credit")
