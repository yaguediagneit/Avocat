# Base de données globale (schéma public + tenants)
DATABASE_URL=postgresql://user:password@localhost:5432/avocat

# Redis
REDIS_URL=redis://localhost:6379

# Session
SESSION_PASSWORD=une_chaine_de_32_octets_au_moins_ici_!!

# S3 / MinIO
S3_ENDPOINT=http://localhost:9000
S3_REGION=us-east-1
S3_ACCESS_KEY_ID=minioadmin
S3_SECRET_ACCESS_KEY=minioadmin
S3_BUCKET=avocat-documents

# Clés de chiffrement du tenant (générées automatiquement)
# TENANT_MASTER_KEY=...

# Meilisearch
MEILISEARCH_HOST=http://localhost:7700
MEILISEARCH_API_KEY=

# Next.js
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Superadmin (liste d'emails séparés par des virgules)
SUPERADMIN_EMAILS=
