# Variables de production — à copier dans Coolify > Environment Variables
# (NE JAMAIS committer les vraies valeurs)

# PostgreSQL — mot de passe du superuser de l'instance
POSTGRES_PASSWORD=

# Session — OBLIGATOIRE, 32 caractères minimum (ex: openssl rand -base64 48)
SESSION_PASSWORD=

# MinIO (stockage des documents chiffrés)
MINIO_ROOT_USER=avocat-minio
MINIO_ROOT_PASSWORD=

# Meilisearch — 16 caractères minimum
MEILI_MASTER_KEY=

# URL publique de l'application (avec https)
APP_URL=https://avocat.votre-domaine.sn

# Emails superadmin, séparés par des virgules
SUPERADMIN_EMAILS=

# Optionnel — rempli APRÈS le premier `tsx init.ts` (id du tenant affiché)
DEFAULT_TENANT_ID=

# Optionnel — clé de chiffrement des documents (générée auto si vide)
TENANT_MASTER_KEY=
